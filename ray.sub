set -eoux pipefail

# Slurm injects the allocation identity into every job step, but the Ray head
# intentionally removes all SLURM_* variables before starting Ray so MPI clients
# do not inherit a stale launcher context. Preserve only the two immutable job
# identity fields under a neutral namespace before that purge. These values then
# remain available to the direct driver command for fail-closed provenance.
if [[ ! "${SLURM_JOB_ID:-}" =~ ^[1-9][0-9]*$ ]]; then
  echo "[FATAL] SLURM_JOB_ID is missing or malformed" >&2
  exit 1
fi
if [[ -z "${SLURM_JOB_NAME:-}" ]]; then
  echo "[FATAL] SLURM_JOB_NAME is missing" >&2
  exit 1
fi
readonly NRL_SLURM_JOB_ID="$SLURM_JOB_ID"
readonly NRL_SLURM_JOB_NAME="$SLURM_JOB_NAME"
export NRL_SLURM_JOB_ID NRL_SLURM_JOB_NAME

# Record job-start epoch so Python can measure pre-Python overhead
export NRL_JOB_START_EPOCH=$(date +%s.%N)

# Log a timestamped, seconds-since-job-start marker at each phase boundary.
log_phase() {
  echo "[NRL_PHASE][$(date '+%Y-%m-%dT%H:%M:%S%z')][+$(( $(date +%s) - ${NRL_JOB_START_EPOCH%.*} ))s] $*"
}
log_phase "ray.sub started (job=${SLURM_JOB_ID:-?} nodes=${SLURM_JOB_NUM_NODES:-?} partition=${SLURM_JOB_PARTITION:-?} node=$(hostname))"

# Preserve the real shell status on EXIT and map asynchronous signals to their
# conventional non-zero statuses. A shared handler that reads `$?` for TERM/HUP/INT
# can report zero when the interrupted command was successful, which would turn a
# cancelled allocation into false completion evidence.
_nrl_finish_exit() {
  local rc="$1"
  local reason="$2"
  local job_id="${SLURM_JOB_ID:-unavailable}"
  local restart_count="${JOB_RESTART_COUNT:-${SLURM_RESTART_COUNT:-0}}"
  local session_name="unavailable"
  local expected_workers="unavailable"
  local completion_status="failed"
  local job_receipt_published=0
  trap - EXIT
  trap '' TERM HUP INT
  set +e
  # Disable xtrace before rendering the control-plane receipt. Otherwise both the
  # function invocation and its echo/printf command can duplicate a success marker
  # across Slurm stdout/stderr, making exact completion ambiguous.
  set +x
  if [[ -n "${LOG_DIR:-}" ]]; then
    touch "$LOG_DIR/ENDED" 2>/dev/null || true
    if [[ -f "$LOG_DIR/RAY_SESSION_NAME" && ! -L "$LOG_DIR/RAY_SESSION_NAME" ]]; then
      IFS= read -r session_name < "$LOG_DIR/RAY_SESSION_NAME" || session_name="unavailable"
      [[ "$session_name" =~ ^session_[A-Za-z0-9._-]+$ ]] || session_name="unavailable"
    fi
  fi
  [[ "$job_id" =~ ^[0-9]+$ ]] || job_id="unavailable"
  [[ "$restart_count" =~ ^[0-9]+$ ]] || restart_count="unavailable"
  if [[ "${SLURM_JOB_NUM_NODES:-}" =~ ^[1-9][0-9]*$ ]]; then
    expected_workers=$((SLURM_JOB_NUM_NODES - 1))
  fi
  # Publish success evidence only from this signal-masked zero-status EXIT path,
  # after all head/worker finalizers have completed. The job receipt is a
  # transaction input to the manifest and is removed if that final commit fails.
  if [[ "$rc" -eq 0 ]]; then
    if [[ "$session_name" == "unavailable" ]] || \
       [[ "$expected_workers" == "unavailable" ]] || \
       ! write-job-completion-receipt "$session_name" "$expected_workers"; then
      echo "[ERROR] Failed to publish job completion receipt" >&2
      rc=1
    else
      job_receipt_published=1
    fi
  fi
  if [[ "$rc" -eq 0 ]]; then
    if ! publish-runtime-artifact-manifest "$session_name" "$expected_workers"; then
      echo "[ERROR] Failed to publish sealed Ray runtime artifact manifest" >&2
      rc=1
    fi
  fi
  if [[ "$rc" -ne 0 ]] && [[ "$job_receipt_published" -eq 1 ]]; then
    if ! cleanup-incomplete-runtime-publication; then
      echo "[ERROR] Failed to remove incomplete runtime success evidence" >&2
    fi
  fi
  [[ "$rc" -eq 0 ]] && completion_status="complete"
  log_phase "ray.sub termination reason=$reason"
  printf '[NRL_JOB_COMPLETION] schema=ray-session-completion-v1 role=job job_id=%s restart_count=%s session=%s status=%s exit_code=%s\n' \
    "$job_id" "$restart_count" "$session_name" "$completion_status" "$rc"
  exit "$rc"
}
_nrl_on_exit() { local rc=$?; _nrl_finish_exit "$rc" EXIT; }
_nrl_on_term() { _nrl_finish_exit 143 TERM; }
_nrl_on_hup() { _nrl_finish_exit 129 HUP; }
_nrl_on_int() { _nrl_finish_exit 130 INT; }
trap _nrl_on_exit EXIT
trap _nrl_on_term TERM
trap _nrl_on_hup HUP
trap _nrl_on_int INT

########################################################
# Function to detect if SLURM cluster uses GRES
########################################################
maybe_gres_arg() {
  # Check if any nodes in the partition have GRES configured
  # Assumes a homogeneous allocation (not a heterogeneous job)
  if sinfo -p $SLURM_JOB_PARTITION -h -o "%G" | grep -q "gpu:"; then
    # Do a quick assert here that gpus:8 == gpus:$GPUS_PER_NODE. It is probably a user error if someone isn't using GPUS_PER_NODE=8 on our clusters if it supports --gres=gpu:8 or gpu:a100:8
    # Some clusters append socket specs like "(S:0-3)" to the GRES string.
    if [[ $GPUS_PER_NODE -ne $(sinfo -p $SLURM_JOB_PARTITION -h -o "%G" | grep "gpu:" | cut -d'(' -f1 | awk -F: '{print $NF}') ]]; then
      echo "Error: GPUS_PER_NODE=$GPUS_PER_NODE but GRES detected is $(sinfo -p $SLURM_JOB_PARTITION -h -o "%G" | grep "gpu:") meaning GPUS_PER_NODE is not set to fully claim the GPUs on the nodes." >&2
      exit 1
    fi
    echo "--gres=gpu:${GPUS_PER_NODE}"
    return
  fi
  
  # No GRES support detected
  echo ""
}

########################################################
# Function to detect the number of CPUs per node from SLURM
########################################################
detect_cpus_per_node() {
  # Query SLURM for the total number of CPUs (CPUTot) on the first allocated
  # node. With --exclusive whole-node allocations (the default for this script)
  # this is the full CPU count of the node, which is what we want to claim per
  # worker so Ray sees every CPU.
  #
  # ASSUMPTION: all allocated nodes have the same CPU count (homogeneous
  # allocation), so reading a single node is sufficient. We deliberately do
  # NOT query every node: each `scontrol show node` is an RPC to the SLURM
  # controller, and issuing one per node across many jobs launched in a burst
  # (e.g. CI) can overwhelm the controller. If your allocation is
  # heterogeneous, set CPUS_PER_WORKER explicitly instead. On any failure we
  # exit (no heuristic fallback); set CPUS_PER_WORKER explicitly to override.
  local nodelist first_node raw cpus
  # `scontrol show hostnames` expands the compressed nodelist string locally
  # (no controller RPC). Take the first line with parameter expansion (no
  # head/grep pipeline, to avoid `set -e`/`pipefail` foot-guns).
  nodelist=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
  first_node=${nodelist%%$'\n'*}
  # Parse "CPUTot=<n>" out of the single-line (`-o`) node description using
  # pure bash parameter expansion.
  raw=$(scontrol show node "$first_node" -o 2>/dev/null || true)
  cpus=${raw#*CPUTot=}
  cpus=${cpus%% *}
  if ! [[ "$cpus" =~ ^[0-9]+$ ]] || [[ "$cpus" -le 0 ]]; then
    echo "Error: Could not determine CPUTot for node '$first_node' from SLURM. Set CPUS_PER_WORKER explicitly to override." >&2
    exit 1
  fi
  echo "$cpus"
}

########################################################
# User defined variables
########################################################
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-16}
CONTAINER=$CONTAINER
MOUNTS=$MOUNTS
COMMAND=${COMMAND:-}  # This is a script relative to the SLURM_SUBMIT_DIR. If left empty, it will leave the cluster idle after it's brought up.
SETUP_COMMAND=${SETUP_COMMAND:-}  # Setup commands to run on all nodes before starting Ray.
# BEGIN RAY_CONTAINER_WORKDIR_POLICY
container-workdir-text-is-safe() {
  local path="$1"
  (( ${#path} <= 4096 )) || return 1
  # Keep this deliberately narrower than arbitrary filesystem path text: every
  # accepted value is later embedded in a whitespace-separated srun argument
  # string.  These four punctuation characters are
  # shell-word safe and restore support for common sweep/version directories
  # (for example, lr=1e-6+mtp@owner:run) without admitting expansion or command
  # separators.
  [[ "$path" =~ ^/[A-Za-z0-9._/@+=:-]+$ ]] || return 1
  [[ "$path" != *//* && "$path" != */ ]] || return 1
  case "/${path#/}/" in
    */./*|*/../*) return 1 ;;
  esac
}

# The Slurm submit directory remains the backwards-compatible default. Callers
# whose host checkout is mounted at a different in-container path must set the
# container namespace path explicitly; it cannot be canonicalized on the host.
CONTAINER_CWD="${CONTAINER_CWD-${SLURM_SUBMIT_DIR-}}"
if ! container-workdir-text-is-safe "$CONTAINER_CWD"; then
  printf "Error: CONTAINER_CWD must be a normalized absolute container path using only letters, digits, '.', '_', '/', '-', '+', '=', '@', and ':'; got %q.\n" "$CONTAINER_CWD" >&2
  exit 1
fi
export CONTAINER_CWD
readonly CONTAINER_CWD
# END RAY_CONTAINER_WORKDIR_POLICY
CONTAINER_INSTANCE_POLICY=${CONTAINER_INSTANCE_POLICY:-job_scoped_named_interactive}
case "$CONTAINER_INSTANCE_POLICY" in
  anonymous_fresh_noninteractive|job_scoped_named_interactive) ;;
  *)
    echo "Error: CONTAINER_INSTANCE_POLICY must be anonymous_fresh_noninteractive or job_scoped_named_interactive, got '$CONTAINER_INSTANCE_POLICY'." >&2
    exit 1
    ;;
esac
if [[ "$CONTAINER_INSTANCE_POLICY" == "anonymous_fresh_noninteractive" ]] && \
   [[ -z "$COMMAND" ]]; then
  echo "Error: anonymous fresh containers do not support idle/attach mode; COMMAND is required." >&2
  exit 1
fi
export CONTAINER_INSTANCE_POLICY
########################################################
# Ports for all nodes (should be odd numbers since we place head/worker[0] on the same node) so all workers get the odd ports, but the head will get +1 the ports
NODE_MANAGER_PORT=${NODE_MANAGER_PORT:-1301}
OBJECT_MANAGER_PORT=${OBJECT_MANAGER_PORT:-1303}
RUNTIME_ENV_AGENT_PORT=${RUNTIME_ENV_AGENT_PORT:-1305}
DASHBOARD_AGENT_GRPC_PORT=${DASHBOARD_AGENT_GRPC_PORT:-1307}
METRICS_EXPORT_PORT=${METRICS_EXPORT_PORT:-1309}

# Ports for the head node -- all below ephemeral floor (9000 on some GB200 nodes).
PORT=${PORT:-1200}
RAY_CLIENT_SERVER_PORT=${RAY_CLIENT_SERVER_PORT:-1201}
#REDIT_SHARD_PORTS=${REDIT_SHARD_PORTS:-"random"} ??
DASHBOARD_PORT=${DASHBOARD_PORT:-8265}  # Also used by debugger
DASHBOARD_AGENT_LISTEN_PORT=${DASHBOARD_AGENT_LISTEN_PORT:-1311}
RAY_DEBUGGER_ARGS=
if [ "${RAY_DEBUG:-}" = "legacy" ]; then
  RAY_DEBUGGER_ARGS="--ray-debugger-external"
fi

# After ray>=2.47, this feature is enabled by default which creates uv venvs for any py_executable starting with `uv run`.
# There is severe contention and performance issues with this enabled considering our dependencies are so large and occasionally
# need to be compiled, so NeMo RL has an implementation in nemo_rl/utils/venv.py that does it once per node as opposed to once per task.
export RAY_ENABLE_UV_RUN_RUNTIME_ENV=0

# Optional override for policy.tokenizer.use_fastokens (Rust-backed BPE tokenizer,
# ~10x faster encode). The config is the source of truth; propagate this env var
# to all Ray nodes ONLY when the user explicitly set it before submitting.
# Unset means "defer to config"; forcing a default here would override config off.
if [[ -n "${NRL_USE_FASTOKENS:-}" ]]; then
  export NRL_USE_FASTOKENS
fi

# Setting ulimit is recommended by ray best practices page
# @ https://docs.ray.io/en/latest/cluster/vms/user-guides/large-cluster-best-practices.html
# It's session based and won't affect the system outside the script
# Ensure that the soft limit isn't above the hard limit
if [[ $(ulimit -Hn) == "unlimited" ]] || [[ 65535 -lt $(ulimit -Hn) ]]; then
  ulimit -Sn 65535
elif [[ $(ulimit -Hn) != "unlimited" ]] && [[ $(ulimit -Hn) -lt 65535 ]]; then
  echo "[WARNING]: Cannot increase ulimit on file descriptors to 65535 according ray recommendation: https://docs.ray.io/en/latest/cluster/vms/user-guides/large-cluster-best-practices.html. Speak to cluster admins to increase, otherwise ray may crash unexpectedly."
fi

# Worker port range must NOT overlap with the OS ephemeral range to prevent
# TOCTOU collisions.  Ray's Raylet uses a probe-and-release pattern
# (CheckPortFree) that can leave a window where the port is unguarded.
# If the range overlaps with the ephemeral range, the kernel can assign the same
# port as an ephemeral source port for outgoing TCP traffic during that window,
# causing EADDRINUSE when the worker tries to bind.
#
# The ephemeral range is 9000-65000 on some DGX/GB200 nodes (32768-60999 on
# stock Linux).  All service ports are pinned below 9000 to stay clear of even
# the lowest observed ephemeral floor.
#
# Port layout (all below ephemeral floor at 9000). Python port-range bounds
# are half-open: [low, high).
#   1200-1201    Ray GCS + client server (head only)
#   1301-1312    Ray management (node-mgr, obj-mgr, etc.; odd=worker, even=head)
#   1313-1399    Dynamo etcd/NATS control plane (driver-local allocation)
#   1400-1999    Master address / TCPStore (cluster.master_port_range_low/high)
#   2000-2999    Ray worker gRPC (min/max-worker-port)
#   [3000, 4999) Shared NeMo RL generation range (policy.generation.port_range_low/high)
#     [3000, 4000) Dynamo frontend/token-wrapper HTTP endpoints
#     [4000, 4100) Dynamo worker system endpoints (node-local free-port selection)
#   5000-5999    NeMo Gym HTTP servers (Gym global config port_range_low/high)
#   6000         Sandbox Nginx (NEMO_SKILLS_SANDBOX_PORT)
#   6001-6999    Sandbox uWSGI workers (SANDBOX_BASE_PORT)
#   7000-8999    vLLM engine rendezvous (VLLM_PORT in vllm_worker.py)
#   8265         Ray Dashboard (DASHBOARD_PORT; reserved carve-out inside the 7000-8999 band)
#   8600-8799    SGLang router (carve-out inside the 7000-8999 band; only one rollout backend runs)
#   8800-8999    SGLang Prometheus metrics (carve-out inside the 7000-8999 band)
MIN_WORKER_PORT=${MIN_WORKER_PORT:-2000}
MAX_WORKER_PORT=${MAX_WORKER_PORT:-2999}
########################################################
# Number seconds to sync logs from the head-authenticated Ray session to $LOG_DIR/ray/
RAY_LOG_SYNC_FREQUENCY=${RAY_LOG_SYNC_FREQUENCY:-}
# Maximum seconds a worker may wait for its local Ray session to resolve to the
# session name authenticated by the head. This is intentionally independent of
# log-sync frequency: provenance is mandatory even when periodic log sync is off.
RAY_SESSION_ATTEST_TIMEOUT=${RAY_SESSION_ATTEST_TIMEOUT:-300}
if ! [[ "$RAY_SESSION_ATTEST_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
  echo "Error: RAY_SESSION_ATTEST_TIMEOUT must be a positive integer, got '$RAY_SESSION_ATTEST_TIMEOUT'." >&2
  exit 1
fi

# BEGIN RAY_FINAL_SYNC_WATCHDOG_POLICY
ray-final-sync-watchdog-seconds() {
  local node_count="$1"
  local base_seconds="$2"
  local per_node_seconds="$3"
  local maximum_seconds="$4"
  local additional_nodes additional_seconds

  [[ "$node_count" =~ ^[1-9][0-9]*$ && ${#node_count} -le 6 ]] || return 1
  [[ "$base_seconds" =~ ^[1-9][0-9]*$ && ${#base_seconds} -le 5 ]] || return 1
  [[ "$per_node_seconds" =~ ^(0|[1-9][0-9]*)$ && ${#per_node_seconds} -le 5 ]] || return 1
  [[ "$maximum_seconds" =~ ^[1-9][0-9]*$ && ${#maximum_seconds} -le 5 ]] || return 1
  (( base_seconds <= 86400 )) || return 1
  (( per_node_seconds <= 86400 )) || return 1
  (( maximum_seconds <= 86400 && maximum_seconds >= base_seconds )) || return 1

  additional_nodes=$((node_count - 1))
  if (( per_node_seconds == 0 )); then
    printf '%s\n' "$base_seconds"
  elif (( additional_nodes > (maximum_seconds - base_seconds) / per_node_seconds )); then
    printf '%s\n' "$maximum_seconds"
  else
    additional_seconds=$((additional_nodes * per_node_seconds))
    printf '%s\n' "$((base_seconds + additional_seconds))"
  fi
}
# END RAY_FINAL_SYNC_WATCHDOG_POLICY

# Final log copies run concurrently to distinct node-specific trees, but their
# aggregate shared-filesystem bandwidth can still fall as allocation size grows.
# Preserve the historical five-minute floor for small jobs, budget another 15
# seconds per additional node, and use a one-hour fail-closed ceiling by default.
RAY_FINAL_SYNC_BASE_TIMEOUT_SECONDS=${RAY_FINAL_SYNC_BASE_TIMEOUT_SECONDS:-300}
RAY_FINAL_SYNC_PER_NODE_TIMEOUT_SECONDS=${RAY_FINAL_SYNC_PER_NODE_TIMEOUT_SECONDS:-15}
RAY_FINAL_SYNC_MAX_TIMEOUT_SECONDS=${RAY_FINAL_SYNC_MAX_TIMEOUT_SECONDS:-3600}
readonly RAY_FINAL_SYNC_BASE_TIMEOUT_SECONDS
readonly RAY_FINAL_SYNC_PER_NODE_TIMEOUT_SECONDS
readonly RAY_FINAL_SYNC_MAX_TIMEOUT_SECONDS
if ! RAY_FINAL_SYNC_WATCHDOG_SECONDS=$(ray-final-sync-watchdog-seconds \
  "$SLURM_JOB_NUM_NODES" \
  "$RAY_FINAL_SYNC_BASE_TIMEOUT_SECONDS" \
  "$RAY_FINAL_SYNC_PER_NODE_TIMEOUT_SECONDS" \
  "$RAY_FINAL_SYNC_MAX_TIMEOUT_SECONDS"); then
  echo "Error: invalid Ray final-sync timeout policy: nodes='$SLURM_JOB_NUM_NODES', base='$RAY_FINAL_SYNC_BASE_TIMEOUT_SECONDS', per_node='$RAY_FINAL_SYNC_PER_NODE_TIMEOUT_SECONDS', maximum='$RAY_FINAL_SYNC_MAX_TIMEOUT_SECONDS'." >&2
  exit 1
fi
readonly RAY_FINAL_SYNC_WATCHDOG_SECONDS
########################################################

# Unset UV_CACHE_DIR to avoid local cache directory interferring with the container cache
unset UV_CACHE_DIR

if [[ -n "${UV_CACHE_DIR_OVERRIDE:-}" ]]; then
  mkdir -p "$UV_CACHE_DIR_OVERRIDE"
  if [[ -n $MOUNTS ]]; then
    MOUNTS+=",$UV_CACHE_DIR_OVERRIDE:/root/.cache/uv"
  else
    MOUNTS="$UV_CACHE_DIR_OVERRIDE:/root/.cache/uv"
  fi
fi

# Create logs directory
# NOTE: LOG_DIR must be on a shared filesystem visible to both the submit host and
# all compute nodes. File-based signaling between the submit host and the containers
# (STARTED_RAY_HEAD, ray_worker_units, ENDED, sandbox readiness) relies on this.
BASE_LOG_DIR=${BASE_LOG_DIR:-$SLURM_SUBMIT_DIR}
# On a Slurm requeue/restart, suffix the restart count so we don't clobber the
# previous attempt's logs (and signal files) under the same job ID.
if [[ -n "${SLURM_RESTART_COUNT:-}" ]]; then
  LOG_DIR="$BASE_LOG_DIR/$SLURM_JOB_ID-$SLURM_RESTART_COUNT-logs"
else
  LOG_DIR="$BASE_LOG_DIR/$SLURM_JOB_ID-logs"
fi
mkdir -p $LOG_DIR
JOB_RESTART_COUNT="${SLURM_RESTART_COUNT:-0}"
RAY_SESSION_COMPLETION_DIR="$LOG_DIR/RAY_SESSION_COMPLETIONS"
RAY_JOB_COMPLETION_RECEIPT="$LOG_DIR/RAY_JOB_COMPLETION"
RAY_RUNTIME_ARTIFACT_MANIFEST="$LOG_DIR/RAY_RUNTIME_ARTIFACTS.json"
RUNTIME_ARTIFACT_MANIFEST_HELPER="$LOG_DIR/runtime_artifact_manifest.py"
WORKER_FINALIZE_REQUEST="$LOG_DIR/WORKER_FINALIZE_REQUEST"

# BEGIN RAY_CONTAINER_INSTANCE_ARG_HELPER
ray-container-instance-arg() {
  local role="$1"
  case "$CONTAINER_INSTANCE_POLICY" in
    anonymous_fresh_noninteractive)
      # Omitting --container-name forces Pyxis/Enroot to instantiate the image
      # for this srun instead of reopening a named, mutable rootfs.
      return 0
      ;;
    job_scoped_named_interactive)
      [[ "$role" == head || "$role" == worker ]] || return 1
      printf '%s' "--container-name=ray-${role}-${SLURM_JOB_ID}-${JOB_RESTART_COUNT}"
      ;;
    *) return 1 ;;
  esac
}
# END RAY_CONTAINER_INSTANCE_ARG_HELPER

HEAD_CONTAINER_INSTANCE_ARG="$(ray-container-instance-arg head)"
WORKER_CONTAINER_INSTANCE_ARG="$(ray-container-instance-arg worker)"
readonly HEAD_CONTAINER_INSTANCE_ARG WORKER_CONTAINER_INSTANCE_ARG
echo "[INFO] Container instance policy: $CONTAINER_INSTANCE_POLICY"

# LOG_DIR must be shared across all nodes. Write a canary the head and worker
# containers check at startup: a node that can't see it isn't on the shared FS, so
# we fail there immediately instead of hanging on signal files that never appear.
echo "$SLURM_JOB_ID" > "$LOG_DIR/.shared_fs_canary"
log_phase "shared-FS log dir ready ($LOG_DIR)"

# Write setup commands to a file so they can be executed inside each container
# without heredoc escaping surprises.
SETUP_COMMAND_FILE=""
if [[ -n "$SETUP_COMMAND" ]]; then
  SETUP_COMMAND_FILE="$LOG_DIR/setup_command.sh"
  echo "$SETUP_COMMAND" > "$SETUP_COMMAND_FILE"
  chmod +x "$SETUP_COMMAND_FILE"
fi

# Write COMMAND to a file so the head container can run it without heredoc/quoting
# issues. Its presence is also how the head decides non-interactive vs interactive.
DRIVER_COMMAND_FILE=""
if [[ -n "$COMMAND" ]]; then
  DRIVER_COMMAND_FILE="$LOG_DIR/driver_command.sh"
  printf '%s' "$COMMAND" > "$DRIVER_COMMAND_FILE"
  chmod +x "$DRIVER_COMMAND_FILE"
fi

# Number of GPUs per worker node
GPUS_PER_NODE=${GPUS_PER_NODE:-8}
DEDICATED_RAY_HEAD=${DEDICATED_RAY_HEAD:-0}
case "$DEDICATED_RAY_HEAD" in
  0|1) ;;
  *)
    echo "Error: DEDICATED_RAY_HEAD must be 0 or 1, got '$DEDICATED_RAY_HEAD'." >&2
    exit 1
    ;;
esac

# Detect GRES support and set GRES_ARG
log_phase "detecting GRES support (sinfo)"
GRES_ARG=$(maybe_gres_arg)
if [[ -n "$GRES_ARG" ]]; then
  echo "[INFO] GRES support detected. Using: $GRES_ARG"
else
  echo "[INFO] No GRES support detected. Running without --gres flag."
fi

COMMON_SRUN_ARGS="$GRES_ARG"
COMMON_SRUN_ARGS+=" --no-container-mount-home"
COMMON_SRUN_ARGS+=" --mpi=pmix"
COMMON_SRUN_ARGS+=" --container-mounts=$MOUNTS"
COMMON_SRUN_ARGS+=" --container-image=$CONTAINER"
COMMON_SRUN_ARGS+=" --container-workdir=$CONTAINER_CWD"
# Pass partition/account explicitly for overlapping srun calls.
COMMON_SRUN_ARGS+=" -p $SLURM_JOB_PARTITION"
COMMON_SRUN_ARGS+=" -A $SLURM_JOB_ACCOUNT"
# Number of CPUs per worker node. If the user did not set CPUS_PER_WORKER
# explicitly, auto-detect it from SLURM so we claim every CPU the node actually
# has (instead of the old GPUS_PER_NODE * 16 heuristic, which under-claims on
# nodes with more cores). Detection queries a single node and assumes a
# homogeneous allocation; set CPUS_PER_WORKER explicitly to override.
if [[ -n "${CPUS_PER_WORKER:-}" ]]; then
  echo "[INFO] Using user-provided CPUS_PER_WORKER=$CPUS_PER_WORKER."
else
  log_phase "auto-detecting CPUs per node (scontrol show node)"
  CPUS_PER_WORKER=$(detect_cpus_per_node)
  echo "[INFO] Auto-detected CPUS_PER_WORKER=$CPUS_PER_WORKER from SLURM (CPUTot of first allocated node)."
fi

# ---------------------------------------------------------------------------
# GCS burst-tolerance tuning for larger jobs
#
# During init, the burst of actor creation triggers thousands of RegisterWorker
# RPCs to the single GCS server on the head node. The burst of traffic causes
# overloads which create cascading failures: GCS RPC queue backs up -> workers
# timeout during registration -> raylet kills them -> NCCL collectives hang.
#
# These settings increase GCS throughput, extend timeouts to survive the burst,
# and reduce background RPC noise during init. Set via RAY_<config_name> env
# vars which Ray reads at process startup.
#
# Config reference: https://github.com/ray-project/ray/blob/master/src/ray/common/ray_config_def.h
# ---------------------------------------------------------------------------

# --- GCS RPC thread pools ---
# Size the GCS gRPC pools from the head node's core count (CPUS_PER_WORKER, the
# per-node CPUTot resolved above) so they scale with the hardware instead of a
# fixed guess. Ray's own default is hardware_concurrency / 4; we use the full
# core count for the request-poll pool and half for the reply pool to drain
# registration bursts faster on high-core-count nodes (e.g. 128 on H100, 144 on
# GB200/Grace).
# gcs_server_rpc_server_thread_num: threads that poll for incoming gRPC requests.
# num_server_call_thread: threads that send gRPC replies.
# gcs_server_rpc_client_thread_num (default max(1, cores/4)): threads that poll
#   replies to the GCS's own outbound RPCs to raylets/workers. Match it to the
#   inbound server pool so the outbound reply path does not become the
#   bottleneck once the request pool is widened.
export RAY_gcs_server_rpc_server_thread_num="${RAY_gcs_server_rpc_server_thread_num:-$CPUS_PER_WORKER}"
export RAY_num_server_call_thread="${RAY_num_server_call_thread:-$(( CPUS_PER_WORKER / 2 > 0 ? CPUS_PER_WORKER / 2 : 1 ))}"
export RAY_gcs_server_rpc_client_thread_num="${RAY_gcs_server_rpc_client_thread_num:-$CPUS_PER_WORKER}"

# --- GCS active RPC headroom ---
# gcs_max_active_rpcs_per_handler (default gcs_server_rpc_server_thread_num*100):
#   max concurrent in-flight RPCs per GCS handler. Give 2x the auto default so
#   the handler queue does not cap out when thousands of actors register
#   simultaneously without staggering.
export RAY_gcs_max_active_rpcs_per_handler="${RAY_gcs_max_active_rpcs_per_handler:-$(( CPUS_PER_WORKER * 200 ))}"

# --- Registration and RPC timeouts ---
# With thread tuning, GCS should drain even the worst burst in ~60s. 120s gives
# 2x margin while keeping failure detection under 2 minutes.
#
# worker_register_timeout_seconds (default 60s): raylet kills unregistered
#   workers after this timeout.
# gcs_rpc_server_connect_timeout_s (default 5s): initial GCS connection
#   timeout. Extremely tight at scale — workers fail to get cluster ID.
# gcs_rpc_server_reconnect_timeout_s (default 60s): max reconnection wait.
# gcs_server_request_timeout_seconds (default 60s): synchronous GCS requests.
export RAY_worker_register_timeout_seconds="${RAY_worker_register_timeout_seconds:-120}"
export RAY_gcs_rpc_server_connect_timeout_s="${RAY_gcs_rpc_server_connect_timeout_s:-120}"
export RAY_gcs_rpc_server_reconnect_timeout_s="${RAY_gcs_rpc_server_reconnect_timeout_s:-120}"
export RAY_gcs_server_request_timeout_seconds="${RAY_gcs_server_request_timeout_seconds:-120}"

# --- Reduce background RPC noise during init ---
# raylet_report_resources_period_milliseconds (default 100ms): at many nodes
#   the resource-report RPCs/sec hitting GCS add up quickly. 500ms reduces
#   this 5x, freeing GCS capacity during the burst.
# task_events_report_interval_ms (default 1000ms): task status pushed to GCS
#   for dashboard observability. 5000ms reduces this 5x. Dashboard will show
#   slightly stale task status during init — acceptable tradeoff.
export RAY_raylet_report_resources_period_milliseconds="${RAY_raylet_report_resources_period_milliseconds:-500}"
export RAY_task_events_report_interval_ms="${RAY_task_events_report_interval_ms:-5000}"

# --- Cap idle task worker pool ---
# num_workers_soft_limit (default -1 = number of CPUs): on high-core-count nodes
#   the raylet accumulates many idle worker processes, each holding a GCS
#   connection. This is a deliberately low fixed cap (not scaled with cores) —
#   our task workers are short-lived (port discovery, GPU ID queries), so 16
#   concurrent per node is plenty.
export RAY_num_workers_soft_limit="${RAY_num_workers_soft_limit:-16}"

# --- Reduce gRPC keepalive overhead ---
# grpc_keepalive_time_ms (default 10s): interval at which the GCS gRPC server
#   sends keepalive pings on its client connections (client->GCS pings are a
#   separate knob, grpc_client_keepalive_time_ms, default 5min). At many nodes
#   these pings are a steady GCS-side load; 60s cuts the rate 6x.
# grpc_keepalive_timeout_ms (default 20s): keepalive ACK timeout. Keep it >= the
#   ping interval so GCS load spikes don't trip false dead-connection detection.
export RAY_grpc_keepalive_time_ms="${RAY_grpc_keepalive_time_ms:-60000}"
export RAY_grpc_keepalive_timeout_ms="${RAY_grpc_keepalive_timeout_ms:-60000}"

# --- Disable observability features not needed at scale ---
# enable_timeline (default true): every actor/task creation emits a timeline
#   event to GCS. Disabling removes thousands of GCS writes during init.
# event_stats (default true): internal event-loop statistics collection.
#   Disabling trims per-event overhead in the GCS event loop.
export RAY_enable_timeline="${RAY_enable_timeline:-false}"
export RAY_event_stats="${RAY_event_stats:-false}"

# --- Reduce syncer, heartbeat, and health-check background traffic ---
# ray_syncer_message_refresh_interval_ms (default 3s): periodic cross-node state
#   refresh via ray_syncer. 10s reduces this 3x.
# core_worker_internal_heartbeat_ms (default 1s): worker->raylet heartbeat.
#   Thousands of workers at 1s add indirect GCS load via raylet aggregation;
#   5s is sufficient.
# health_check_period_ms (default 3s): GCS->node health probes. 10s applies for
#   the whole job, not just init: with defaults (threshold 5, timeout 10s),
#   dead-node detection slows ~3x (~15s -> ~50s; up to ~100s if probes hang to
#   the timeout) — accepted in exchange for GCS headroom during the burst.
export RAY_ray_syncer_message_refresh_interval_ms="${RAY_ray_syncer_message_refresh_interval_ms:-10000}"
export RAY_core_worker_internal_heartbeat_ms="${RAY_core_worker_internal_heartbeat_ms:-5000}"
export RAY_health_check_period_ms="${RAY_health_check_period_ms:-10000}"

# The head is retried a few times. Workers may need more attempts since they can
# race the head's GCS coming up: `ray start --address` fails until GCS is listening.
num_retries=3
WORKER_NUM_RETRIES=20

# Total Ray worker_units expected once every schedulable GPU node has
# registered. In dedicated-head mode the first physical node runs only the Ray
# control plane and driver, and intentionally contributes no GPU worker units.
NUM_RAY_GPU_NODES=$((SLURM_JOB_NUM_NODES - DEDICATED_RAY_HEAD))
if (( NUM_RAY_GPU_NODES <= 0 )); then
  echo "Error: dedicated Ray head requires at least one additional GPU worker node." >&2
  exit 1
fi
NUM_ACTORS=$((GPUS_PER_NODE * NUM_RAY_GPU_NODES))
if (( DEDICATED_RAY_HEAD == 1 )); then
  echo "[INFO] DEDICATED_RAY_HEAD=1: $NUM_RAY_GPU_NODES of $SLURM_JOB_NUM_NODES allocated nodes are GPU compute nodes."
  echo "[INFO] Size your driver COMMAND to $NUM_RAY_GPU_NODES nodes (cluster.num_nodes, plus env.nemo_gym.num_gpu_nodes when set); ray.sub cannot validate this for you."
fi

# Track backgrounded srun client PIDs for head and workers
declare -A SRUN_PIDS

# Verify all backgrounded srun client processes are still alive; exit fast if any died
check_srun_processes() {
  for name in "${!SRUN_PIDS[@]}"; do
    pid="${SRUN_PIDS[$name]}"
    # Check if the process is still running
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "[ERROR] Background srun '$name' died (pid=$pid). Could be a failure in startup or an issue with the node preventing the srun to start. Attempting to exit." >&2
      # Signal sidecars inside containers to terminate ASAP
      touch "$LOG_DIR/ENDED"
      exit 1
    fi
  done
}

# Once finalization begins, bound the entire remaining srun step. The node-local
# command timeout normally reports a clean failure first; this is the submit-side
# backstop for a stuck pre-copy operation, sidecar, shared-filesystem operation,
# or cleanup. A timed-out child cannot turn the timeout into a false success by
# handling TERM and exiting zero.
wait-for-finalization() {
  local target_pid="$1"
  local finalization_observed="$2"
  local timeout_seconds="$3"
  local description="$4"
  local kill_grace_seconds="${5:-10}"
  local graceful_signal="${6:-TERM}"
  local force_signal="${7:-KILL}"
  local deadline force_deadline reap_deadline target_exit_code tracked_pid tree_output
  local timed_out=0
  local alive=0
  local force_sent=0
  local collection_failed=0
  local -a target_tree_pids=()

  [[ "$target_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$finalization_observed" =~ ^[01]$ ]] || return 1
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -n "$description" ]] || return 1
  [[ "$kill_grace_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$graceful_signal" =~ ^[A-Z][A-Z0-9]*$ ]] || return 1
  [[ "$force_signal" =~ ^[A-Z][A-Z0-9]*$ ]] || return 1

  if [[ "$finalization_observed" -eq 1 ]]; then
    deadline=$((SECONDS + timeout_seconds))
    while kill -0 "$target_pid" 2>/dev/null; do
      if (( SECONDS >= deadline )); then
        timed_out=1
        echo "[ERROR] Timed out after ${timeout_seconds}s waiting for ${description}" >&2
        if tree_output=$(collect-process-tree-pids "$target_pid"); then
          while IFS= read -r tracked_pid; do
            [[ "$tracked_pid" =~ ^[1-9][0-9]*$ ]] || continue
            target_tree_pids+=("$tracked_pid")
          done <<< "$tree_output"
        else
          collection_failed=1
          target_tree_pids+=("$target_pid")
          echo "[ERROR] Could not enumerate the ${description} process tree" >&2
        fi
        if (( ${#target_tree_pids[@]} > 0 )); then
          kill "-$graceful_signal" "${target_tree_pids[@]}" 2>/dev/null || true
        fi
        break
      fi
      sleep 1
    done
  fi
  if [[ "$timed_out" -eq 1 ]]; then
    force_deadline=$((SECONDS + kill_grace_seconds))
    while (( SECONDS < force_deadline )); do
      alive=0
      for tracked_pid in "${target_tree_pids[@]}"; do
        if kill -0 "$tracked_pid" 2>/dev/null; then
          alive=1
          break
        fi
      done
      (( alive == 1 )) || break
      sleep 1
    done
    if (( alive == 1 )); then
      force_sent=1
      echo "[ERROR] ${description} ignored ${graceful_signal} for ${kill_grace_seconds}s; sending ${force_signal}" >&2
      # Capture any descendant created by a TERM handler before forcing the
      # complete remaining tree down.
      if tree_output=$(collect-process-tree-pids "$target_pid"); then
        while IFS= read -r tracked_pid; do
          [[ "$tracked_pid" =~ ^[1-9][0-9]*$ ]] || continue
          target_tree_pids+=("$tracked_pid")
        done <<< "$tree_output"
      else
        collection_failed=1
      fi
      kill "-$force_signal" "${target_tree_pids[@]}" 2>/dev/null || true
    fi
  fi

  if (( force_sent == 1 )); then
    reap_deadline=$((SECONDS + kill_grace_seconds))
    while (( SECONDS < reap_deadline )); do
      alive=0
      for tracked_pid in "${target_tree_pids[@]}"; do
        if kill -0 "$tracked_pid" 2>/dev/null; then
          alive=1
          break
        fi
      done
      (( alive == 1 )) || break
      sleep 1
    done
    if kill -0 "$target_pid" 2>/dev/null; then
      echo "[ERROR] ${description} remained alive after ${force_signal}; refusing an unbounded wait" >&2
      return 1
    fi
  fi

  wait "$target_pid"
  target_exit_code=$?
  if [[ "$timed_out" -eq 1 ]] && [[ "$target_exit_code" -eq 0 ]]; then
    target_exit_code=1
  fi
  if [[ "$collection_failed" -eq 1 ]] && [[ "$target_exit_code" -eq 0 ]]; then
    target_exit_code=1
  fi
  return "$target_exit_code"
}

# A secondary finalization failure must not erase the driver's exact nonzero
# status. Only a previously successful primary path is canonicalized to 1.
merge-finalization-exit-code() {
  local primary_exit_code="$1"
  local secondary_exit_code="$2"

  [[ "$primary_exit_code" =~ ^(0|[1-9][0-9]*)$ ]] || return 1
  [[ "$secondary_exit_code" =~ ^(0|[1-9][0-9]*)$ ]] || return 1
  (( primary_exit_code <= 255 && secondary_exit_code <= 255 )) || return 1

  if (( primary_exit_code != 0 )); then
    return "$primary_exit_code"
  fi
  if (( secondary_exit_code != 0 )); then
    return 1
  fi
  return 0
}

# Getting the node names and IP addresses in the SLURM allocation
nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
nodes_array=($nodes)
ip_addresses_array=()

log_phase "resolving ${#nodes_array[@]} node hostname(s) to IPs"
for node in $nodes; do
    # Try multiple methods to get IP address - ENHANCED VERSION v2.0
    echo "[DEBUG] Resolving hostname: $node using enhanced resolution methods"
    ip_address=""
    
    # Method 1: Try host command
    echo "[DEBUG] Method 1: host command"
    ip_address=$(host $node 2>/dev/null | awk '/has address/ { print $4 }' | head -1 || true)
    echo "[DEBUG] host result: '$ip_address'"
    
    # Method 2: If host fails, try getent
    if [[ -z "$ip_address" ]]; then
        echo "[DEBUG] Method 2: getent hosts"
        ip_address=$(getent hosts $node 2>/dev/null | awk '{ print $1 }' | head -1 || true)
        echo "[DEBUG] getent result: '$ip_address'"
    fi
    
    # Method 3: If getent fails, try nslookup
    if [[ -z "$ip_address" ]]; then
        echo "[DEBUG] Method 3: nslookup"
        ip_address=$(nslookup $node 2>/dev/null | awk '/^Address: / { print $2 }' | head -1 || true)
        echo "[DEBUG] nslookup result: '$ip_address'"
    fi
    
    # Method 4: If all DNS methods fail, try ping to extract IP
    if [[ -z "$ip_address" ]]; then
        echo "[DEBUG] Method 4: ping"
        ip_address=$(ping -c 1 $node 2>/dev/null | grep "PING" | sed 's/.*(\([^)]*\)).*/\1/' || true)
        echo "[DEBUG] ping result: '$ip_address'"
    fi
    
    # If still no IP, use the hostname itself (might work if it's already an IP or resolvable)
    if [[ -z "$ip_address" ]]; then
        echo "[WARNING] Could not resolve IP for $node, using hostname as fallback"
        ip_address=$node
    fi
    
    echo "[INFO] Node: $node -> IP: $ip_address"
    # Add the IP address to the array
    ip_addresses_array+=("$ip_address")
done

# Sort nodes alphabetically for deterministic startup order.
_sorted_pairs=()
for (( _si = 0; _si < ${#nodes_array[@]}; _si++ )); do
  _sorted_pairs+=("${nodes_array[$_si]}|${ip_addresses_array[$_si]}")
done
IFS=$'\n' _sorted_pairs=($(printf '%s\n' "${_sorted_pairs[@]}" | sort)); unset IFS
nodes_array=()
ip_addresses_array=()
for _pair in "${_sorted_pairs[@]}"; do
  nodes_array+=("${_pair%%|*}")
  ip_addresses_array+=("${_pair##*|}")
done
unset _sorted_pairs _pair _si
echo "[INFO] Nodes after hostname sort: ${nodes_array[*]}"

head_node=${nodes_array[0]}
head_node_ip=${ip_addresses_array[0]}

ip_head=$head_node_ip:$PORT

# Write the topology probe script that runs inside each container.
# Both head_cmd and worker_cmd source this to avoid duplication.
# The script sets two variables: CLUSTER_UUID and TOPO_RANK.
# These are then embedded into the Ray --resources JSON.
#
# CLUSTER_UUID: NVLink fabric ClusterUUID parsed directly from `nvidia-smi -q`.
#   Groups GPUs by NVLink domain (all 72 GPUs in a GB200 NVL72 rack share one UUID).
#   Empty string on DGX/HGX (no fabric) or if nvidia-smi is unavailable.
#
# TOPO_RANK: Topology-aware infrastructure rank.
#   Fallback chain:
#   1. SLURM_TOPOLOGY_ADDR (block.node format) -> block_num * 10^10 + node_num
#   2. SLURM_PROCID + 2 on workers, head pinned to 1 (SLURM without topology plugin)
#   3. Hostname digits (non-SLURM fallback)
#
# TODO(ansubramania): Harden the SLURM_TOPOLOGY_ADDR digit-extraction logic for open source.
#   The current approach (tr -dc '0-9') assumes block/node names contain
#   unique numeric substrings, which holds on internal clusters but
#   may produce collisions on other providers with different naming conventions
#   (e.g., "rack-A1" vs "rack-B1" both yield "1").
TOPO_PROBE_SCRIPT="$LOG_DIR/topology_probe.sh"
cat > "$TOPO_PROBE_SCRIPT" <<TOPO_PROBE_EOF
CLUSTER_UUID=\$(nvidia-smi -q 2>/dev/null | grep 'ClusterUUID' | head -1 | awk -F: '{print \$2}' | tr -d ' ')
if [[ -z "\$CLUSTER_UUID" ]]; then
  CLUSTER_UUID=""
fi

TOPO_RANK=""
if [[ -n "\${SLURM_TOPOLOGY_ADDR:-}" && "\${SLURM_TOPOLOGY_ADDR_PATTERN:-}" == "block.node" ]]; then
  _block_part="\${SLURM_TOPOLOGY_ADDR%%.*}"
  _node_part="\${SLURM_TOPOLOGY_ADDR##*.}"
  _block_digits=\$(echo "\$_block_part" | tr -dc '0-9')
  _node_digits=\$(echo "\$_node_part" | tr -dc '0-9')
  if [[ -n "\$_block_digits" && -n "\$_node_digits" ]]; then
    # Force base-10 interpretation; leading-zero digits like "08" would otherwise
    # be parsed as invalid octal by bash arithmetic, silently leaving TOPO_RANK empty.
    TOPO_RANK=\$(( 10#\$_block_digits * 10000000000 + 10#\$_node_digits ))
  fi
elif [[ -n "\${SLURM_PROCID:-}" ]]; then
  # Head srun and worker srun each start their own SLURM_PROCID counter at 0.
  # Head hardcoded to 1; workers get +2 so worker[0]=2, worker[62]=64 -- keeps
  # all nodes at unique values >=1 (Ray drops value-0 custom resources).
  if [[ "\$SLURMD_NODENAME" == "$head_node" ]]; then
    TOPO_RANK=1
  else
    TOPO_RANK=\$(( 10#\$SLURM_PROCID + 2 ))
  fi
else
  _hostname_digits=\$(hostname | tr -dc '0-9')
  if [[ -n "\$_hostname_digits" ]]; then
    TOPO_RANK=\$(( 10#\$_hostname_digits ))
  fi
fi

# Write GPU→cpulist mapping for NUMA binding.
# IMPORTANT: The env var name NRL_GPU_CPU_AFFINITY_FILE and default path must stay
# in sync with GPU_CPU_AFFINITY_PATH in nemo_rl/distributed/numa_utils.py.
export NRL_GPU_CPU_AFFINITY_FILE="/tmp/nrl_gpu_cpu_affinity"
# nvidia-smi topo -m's CPU Affinity column is unreliable on GB200 (empty for
# GPUs not directly attached to the socket). Use NUMA Affinity (always
# populated, at field NF-1 since GPU NUMA ID is last) and look up the
# node-local CPU list from sysfs. On GB200 the NUMA Affinity column can be a
# list like "0,2-17" (the GPU-local CPU NUMA node plus the GPU's HBM NUMA
# nodes); take the first entry, which is the local CPU NUMA node.
nvidia-smi topo -m 2>/dev/null | awk '/^GPU[0-9]/ {
  gpu = \$1; sub(/GPU/, "", gpu)
  numa = \$(NF-1)
  sub(/[,-].*/, "", numa)
  if (numa ~ /^[0-9]+\$/) print gpu, numa
}' | while read -r _gpu _numa; do
  _cpulist=\$(cat "/sys/devices/system/node/node\${_numa}/cpulist" 2>/dev/null)
  if [[ -n "\$_cpulist" ]]; then
    echo "\${_gpu}:\${_cpulist}"
  fi
done > "\$NRL_GPU_CPU_AFFINITY_FILE" || true
if [[ -s "\$NRL_GPU_CPU_AFFINITY_FILE" ]]; then
  echo "NUMA affinity map written to \$NRL_GPU_CPU_AFFINITY_FILE:"
  cat "\$NRL_GPU_CPU_AFFINITY_FILE"
else
  echo "WARNING: Could not generate NUMA affinity map (nvidia-smi topo unavailable)"
fi

# Use \\\" so that when --resources="\$RAY_RESOURCES" expands, we pass valid JSON to ray
# IMPORTANT: The key names "nvlink_domain_" and "topo_rank" below must stay in sync
# with the constants NVLINK_DOMAIN_PREFIX and TOPO_RANK_KEY defined in
# nemo_rl/distributed/virtual_cluster.py.
# NRL_DEDICATED_RAY_HEAD=1 is exported only by the head under DEDICATED_RAY_HEAD=1.
# That node runs the control plane and driver only, so it advertises no compute
# resources: without worker_units and the topology keys, neither a GPU actor nor a
# topology-constrained placement group can select it. Any new node-level key belongs
# in the else branch unless the dedicated head should carry it too.
RAY_RESOURCES='{\"slurm_managed_ray_cluster\": 1'
if [[ "\${NRL_DEDICATED_RAY_HEAD:-0}" == "1" ]]; then
  RAY_RESOURCES+=', \"ray_head\": 1'
else
  RAY_RESOURCES+=', \"worker_units\": '"$GPUS_PER_NODE"
  if [[ -n "\$CLUSTER_UUID" ]]; then
    RAY_RESOURCES+=', \"nvlink_domain_'\${CLUSTER_UUID}'\": 1'
  fi
  if [[ -n "\$TOPO_RANK" ]]; then
    RAY_RESOURCES+=', \"topo_rank\": '\$TOPO_RANK
  fi
fi
RAY_RESOURCES+='}'
export RAY_RESOURCES
TOPO_PROBE_EOF

# Shared final-sync helpers. Periodic diagnostic copies use a separate untrusted
# tree; only this helper may create the evaluator-visible `ray/.../logs` tree.
# Each final target has its own mkdir lock, so duplicate publication fails closed
# while distinct head/worker targets copy concurrently. The final directory
# appears with one same-filesystem rename only after a complete copy.
FINAL_SYNC_HELPER_SCRIPT="$LOG_DIR/final_sync_helpers.sh"
cat > "$FINAL_SYNC_HELPER_SCRIPT" <<'FINAL_SYNC_HELPER_EOF'
sync-live-ray-logs() {
  local source_logs="$1"
  local live_logs="$2"
  [[ -d "$source_logs" ]] || return 1
  mkdir -p "$live_logs" || return 1
  if command -v rsync >/dev/null 2>&1; then
    rsync -a -- "$source_logs/" "$live_logs/" >/dev/null 2>&1
  else
    cp -a -- "$source_logs/." "$live_logs/"
  fi
}

run-final-sync-command() {
  local timeout_seconds="$1"
  shift
  if [[ -z "$timeout_seconds" ]]; then
    "$@"
    return
  fi
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
  command -v timeout >/dev/null 2>&1 || return 1
  # Keep timeout's command-group isolation: rsync and Ray may spawn children,
  # and every descendant must stop before a failed publication cleans its temp
  # tree. `--foreground` would restrict signaling to the immediate child.
  timeout --kill-after=10s "${timeout_seconds}s" "$@"
}

# Background shell functions share the main shell's process group, so killing a
# group would also kill the finalizer. Snapshot each sidecar's descendant tree,
# signal descendants before their parent, and retain those PIDs so an orphaned
# TERM-resistant child is still force-killed after the bounded grace period.
collect-process-tree-pids() {
  local root_pid="$1"
  local child_pid child_pids child_tree pgrep_status
  [[ "$root_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  command -v pgrep >/dev/null 2>&1 || return 1
  if child_pids=$(pgrep -P "$root_pid" 2>/dev/null); then
    :
  else
    pgrep_status=$?
    (( pgrep_status == 1 )) || return 1
    child_pids=""
  fi
  for child_pid in $child_pids; do
    [[ "$child_pid" =~ ^[1-9][0-9]*$ ]] || continue
    child_tree=$(collect-process-tree-pids "$child_pid") || return 1
    printf '%s\n' "$child_tree"
  done
  printf '%s\n' "$root_pid"
}

stop-background-processes() {
  local kill_grace_seconds="$1"
  local description="$2"
  local graceful_signal="$3"
  local force_signal="$4"
  local require_zero_exit="$5"
  shift 5
  local root_pid tracked_pid tree_output
  local deadline reap_deadline root_exit_status
  local alive=0 forced=0 reap_failed=0 root_exit_failed=0
  local collection_failed=0
  local -a root_pids=()
  local -a tracked_pids=()

  [[ "$kill_grace_seconds" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -n "$description" ]] || return 1
  [[ "$graceful_signal" =~ ^[A-Z][A-Z0-9]*$ ]] || return 1
  [[ "$force_signal" =~ ^[A-Z][A-Z0-9]*$ ]] || return 1
  [[ "$require_zero_exit" =~ ^[01]$ ]] || return 1
  for root_pid in "$@"; do
    [[ "$root_pid" =~ ^[1-9][0-9]*$ ]] || continue
    root_pids+=("$root_pid")
    if tree_output=$(collect-process-tree-pids "$root_pid"); then
      while IFS= read -r tracked_pid; do
        [[ "$tracked_pid" =~ ^[1-9][0-9]*$ ]] || continue
        tracked_pids+=("$tracked_pid")
      done <<< "$tree_output"
    else
      collection_failed=1
      tracked_pids+=("$root_pid")
      echo "[ERROR] Could not enumerate the ${description} process tree" >&2
    fi
  done
  (( ${#root_pids[@]} > 0 )) || return 0

  if (( ${#tracked_pids[@]} > 0 )); then
    kill "-$graceful_signal" "${tracked_pids[@]}" 2>/dev/null || true
  fi
  deadline=$((SECONDS + kill_grace_seconds))
  while (( SECONDS < deadline )); do
    alive=0
    for tracked_pid in "${tracked_pids[@]}"; do
      if kill -0 "$tracked_pid" 2>/dev/null; then
        alive=1
        break
      fi
    done
    (( alive == 1 )) || break
    sleep 1
  done

  alive=0
  for tracked_pid in "${tracked_pids[@]}"; do
    if kill -0 "$tracked_pid" 2>/dev/null; then
      alive=1
      break
    fi
  done
  if (( alive == 1 )); then
    forced=1
    echo "[ERROR] ${description} ignored ${graceful_signal} for ${kill_grace_seconds}s; sending ${force_signal}" >&2
    # Capture descendants created by a TERM handler before forcing the tree down.
    for root_pid in "${root_pids[@]}"; do
      if tree_output=$(collect-process-tree-pids "$root_pid"); then
        while IFS= read -r tracked_pid; do
          [[ "$tracked_pid" =~ ^[1-9][0-9]*$ ]] || continue
          tracked_pids+=("$tracked_pid")
        done <<< "$tree_output"
      else
        collection_failed=1
      fi
    done
    kill "-$force_signal" "${tracked_pids[@]}" 2>/dev/null || true
    reap_deadline=$((SECONDS + kill_grace_seconds))
    while (( SECONDS < reap_deadline )); do
      alive=0
      for tracked_pid in "${tracked_pids[@]}"; do
        if kill -0 "$tracked_pid" 2>/dev/null; then
          alive=1
          break
        fi
      done
      (( alive == 1 )) || break
      sleep 1
    done
  fi

  for root_pid in "${root_pids[@]}"; do
    if kill -0 "$root_pid" 2>/dev/null; then
      reap_failed=1
      echo "[ERROR] ${description} process $root_pid remained alive; refusing an unbounded wait" >&2
    else
      if wait "$root_pid" 2>/dev/null; then
        root_exit_status=0
      else
        root_exit_status=$?
      fi
      if [[ "$require_zero_exit" -eq 1 ]] && [[ "$root_exit_status" -ne 0 ]]; then
        root_exit_failed=1
        echo "[ERROR] ${description} process $root_pid exited nonzero: $root_exit_status" >&2
      fi
    fi
  done
  (( forced == 0 && reap_failed == 0 && collection_failed == 0 && root_exit_failed == 0 ))
}

atomic-final-ray-logs() {
  local source_logs="$1"
  local final_logs="$2"
  local role="$3"
  local timeout_seconds="${4:-}"
  local log_root="${NRL_PROVENANCE_LOG_DIR:?missing NRL_PROVENANCE_LOG_DIR}"
  local final_parent lock_dir tmp

  [[ "$role" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  [[ -d "$source_logs" && ! -L "$source_logs" ]] || return 1
  case "$final_logs" in
    "$log_root"/ray/*/logs) ;;
    *) return 1 ;;
  esac

  final_parent="${final_logs%/logs}"
  mkdir -p "$final_parent" || return 1
  lock_dir="$final_parent/.logs.final-publish-lock"
  # Exactly one process owns a target. A second publisher is a provenance
  # violation, not routine contention, so fail immediately instead of waiting.
  mkdir "$lock_dir" 2>/dev/null || return 1
  tmp="$final_parent/.logs.final-${role}-$$"
  if [[ -e "$final_logs" || -L "$final_logs" || -e "$tmp" || -L "$tmp" ]]; then
    rmdir "$lock_dir" 2>/dev/null || true
    return 1
  fi
  if ! mkdir "$tmp"; then
    rmdir "$lock_dir" 2>/dev/null || true
    return 1
  fi

  if command -v rsync >/dev/null 2>&1; then
    if ! run-final-sync-command \
      "$timeout_seconds" rsync -a -- "$source_logs/" "$tmp/"; then
      rm -rf -- "$tmp"
      rmdir "$lock_dir" 2>/dev/null || true
      return 1
    fi
  elif ! run-final-sync-command \
    "$timeout_seconds" cp -a -- "$source_logs/." "$tmp/"; then
    rm -rf -- "$tmp"
    rmdir "$lock_dir" 2>/dev/null || true
    return 1
  fi

  if ! mv -- "$tmp" "$final_logs"; then
    rm -rf -- "$tmp"
    rmdir "$lock_dir" 2>/dev/null || true
    return 1
  fi
  rmdir "$lock_dir" || return 1
}

atomic-write-provenance-file() {
  local final_path="$1"
  local log_root="${NRL_PROVENANCE_LOG_DIR:?missing NRL_PROVENANCE_LOG_DIR}"
  local tmp_path
  case "$final_path" in
    "$log_root"/RAY_SESSION_COMPLETIONS/*|\
    "$log_root"/RAY_JOB_COMPLETION|\
    "$log_root"/WORKER_FINALIZE_REQUEST) ;;
    *) return 1 ;;
  esac
  [[ ! -e "$final_path" && ! -L "$final_path" ]] || return 1
  mkdir -p "${final_path%/*}" || return 1
  tmp_path="${final_path%/*}/.${final_path##*/}.$$"
  [[ ! -e "$tmp_path" && ! -L "$tmp_path" ]] || return 1
  umask 077
  cat > "$tmp_path" || return 1
  mv -- "$tmp_path" "$final_path"
}

provenance-file-matches() {
  local path="$1"
  local expected="$2"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(cat -- "$path")" == "$expected" ]]
}
FINAL_SYNC_HELPER_EOF
chmod 500 "$FINAL_SYNC_HELPER_SCRIPT"
NRL_PROVENANCE_LOG_DIR="$LOG_DIR"
source "$FINAL_SYNC_HELPER_SCRIPT"

# The submit-side EXIT handler runs this helper only after the driver, head, and
# all expected workers have completed successfully. Keep the implementation in a
# standalone file so the JSON encoding and fd-relative integrity checks do not
# depend on shell escaping or locale-specific coreutils output.
cat > "$RUNTIME_ARTIFACT_MANIFEST_HELPER" <<'RUNTIME_ARTIFACT_MANIFEST_HELPER_EOF'
# BEGIN RAY_RUNTIME_ARTIFACT_MANIFEST_HELPER
from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import sys

SCHEMA = "ray-runtime-artifacts-v1"
ARTIFACT_MODE = 0o444
DIRECTORY_MODE = 0o555
SESSION_PATTERN = re.compile(r"^session_[A-Za-z0-9._-]+$")


def _mode_string(mode: int) -> str:
    return f"{stat.S_IMODE(mode):04o}"


def _open_directory(path: str) -> int:
    path_stat = os.lstat(path)
    if not stat.S_ISDIR(path_stat.st_mode) or stat.S_ISLNK(path_stat.st_mode):
        raise ValueError(f"evidence directory is not a concrete directory: {path}")
    directory_fd = os.open(
        path,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    fd_stat = os.fstat(directory_fd)
    if (path_stat.st_dev, path_stat.st_ino) != (fd_stat.st_dev, fd_stat.st_ino):
        os.close(directory_fd)
        raise RuntimeError(f"evidence directory changed while opening: {path}")
    return directory_fd


def _directory_identity(path: str, directory_fd: int) -> dict[str, object]:
    directory_stat = os.fstat(directory_fd)
    return {
        "path": path,
        "mode": _mode_string(directory_stat.st_mode),
        "device": directory_stat.st_dev,
        "inode": directory_stat.st_ino,
    }


def _verify_directory_path(
    *,
    identity: dict[str, object],
    directory_fd: int,
    parent_fd: int | None = None,
    filename: str | None = None,
) -> None:
    if parent_fd is None:
        path_stat = os.lstat(identity["path"])
    else:
        if filename is None:
            raise ValueError("directory filename is required with a parent fd")
        path_stat = os.stat(filename, dir_fd=parent_fd, follow_symlinks=False)
    fd_stat = os.fstat(directory_fd)
    expected = (identity["device"], identity["inode"], identity["mode"])
    actual = (
        path_stat.st_dev,
        path_stat.st_ino,
        _mode_string(path_stat.st_mode),
    )
    fd_actual = (
        fd_stat.st_dev,
        fd_stat.st_ino,
        _mode_string(fd_stat.st_mode),
    )
    if (
        not stat.S_ISDIR(path_stat.st_mode)
        or stat.S_ISLNK(path_stat.st_mode)
        or actual != expected
        or fd_actual != expected
    ):
        raise RuntimeError(f"sealed evidence directory identity changed: {identity['path']}")


def _require_exact_entries(
    directory_fd: int,
    *,
    path: str,
    expected_entries: list[str],
) -> None:
    actual_entries = sorted(os.listdir(directory_fd))
    if actual_entries != sorted(expected_entries):
        raise ValueError(
            f"unexpected evidence directory contents for {path}: "
            f"expected={sorted(expected_entries)!r}, actual={actual_entries!r}"
        )


def _entry_exists(directory_fd: int, name: str) -> bool:
    try:
        os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return False
    return True


def _sha256_fd(file_fd: int) -> str:
    digest = hashlib.sha256()
    os.lseek(file_fd, 0, os.SEEK_SET)
    while True:
        chunk = os.read(file_fd, 1024 * 1024)
        if not chunk:
            break
        digest.update(chunk)
    return digest.hexdigest()


def _seal_artifact(
    *,
    artifact_name: str,
    filename: str,
    parent_path: str,
    parent_fd: int,
) -> tuple[int, dict[str, object]]:
    path_stat = os.stat(filename, dir_fd=parent_fd, follow_symlinks=False)
    if not stat.S_ISREG(path_stat.st_mode) or stat.S_ISLNK(path_stat.st_mode):
        raise ValueError(f"runtime artifact is not a concrete regular file: {parent_path}/{filename}")
    file_fd = os.open(
        filename,
        os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
        dir_fd=parent_fd,
    )
    fd_stat = os.fstat(file_fd)
    if (path_stat.st_dev, path_stat.st_ino) != (fd_stat.st_dev, fd_stat.st_ino):
        os.close(file_fd)
        raise RuntimeError(f"runtime artifact changed while opening: {parent_path}/{filename}")

    os.fchmod(file_fd, ARTIFACT_MODE)
    os.fsync(file_fd)
    sha256 = _sha256_fd(file_fd)
    sealed_stat = os.fstat(file_fd)
    if _mode_string(sealed_stat.st_mode) != "0444":
        os.close(file_fd)
        raise RuntimeError(f"runtime artifact did not seal read-only: {parent_path}/{filename}")
    return file_fd, {
        "name": artifact_name,
        "path": os.path.join(parent_path, filename),
        "sha256": sha256,
        "size": sealed_stat.st_size,
        "mode": _mode_string(sealed_stat.st_mode),
        "device": sealed_stat.st_dev,
        "inode": sealed_stat.st_ino,
        "mtime_ns": sealed_stat.st_mtime_ns,
    }


def _open_child_directory(
    *,
    parent_path: str,
    parent_fd: int,
    filename: str,
) -> int:
    path_stat = os.stat(filename, dir_fd=parent_fd, follow_symlinks=False)
    if not stat.S_ISDIR(path_stat.st_mode) or stat.S_ISLNK(path_stat.st_mode):
        raise ValueError(f"final log entry is not a concrete directory: {parent_path}/{filename}")
    directory_fd = os.open(
        filename,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
        dir_fd=parent_fd,
    )
    fd_stat = os.fstat(directory_fd)
    if (path_stat.st_dev, path_stat.st_ino) != (fd_stat.st_dev, fd_stat.st_ino):
        os.close(directory_fd)
        raise RuntimeError(f"final log directory changed while opening: {parent_path}/{filename}")
    return directory_fd


def _seal_final_log_tree(
    *,
    role: str,
    directory_name: str,
    directory_path: str,
    directory_fd: int,
    parent_fd: int,
    filename: str,
    relative_path: str,
    artifacts: list[dict[str, object]],
    artifact_handles: list[dict[str, object]],
    directory_handles: list[dict[str, object]],
    open_directory_fds: list[int],
) -> None:
    expected_entries = sorted(os.listdir(directory_fd))
    for entry in expected_entries:
        entry_stat = os.stat(entry, dir_fd=directory_fd, follow_symlinks=False)
        entry_relative_path = entry if not relative_path else f"{relative_path}/{entry}"
        if stat.S_ISREG(entry_stat.st_mode) and not stat.S_ISLNK(entry_stat.st_mode):
            file_fd, artifact = _seal_artifact(
                artifact_name=f"final_log/{role}/{entry_relative_path}",
                filename=entry,
                parent_path=directory_path,
                parent_fd=directory_fd,
            )
            artifact["role"] = role
            artifact["relative_path"] = entry_relative_path
            artifacts.append(artifact)
            artifact_handles.append(
                {
                    "artifact": artifact,
                    "filename": entry,
                    "parent_fd": directory_fd,
                    "file_fd": file_fd,
                }
            )
        elif stat.S_ISDIR(entry_stat.st_mode) and not stat.S_ISLNK(entry_stat.st_mode):
            child_path = os.path.join(directory_path, entry)
            child_fd = _open_child_directory(
                parent_path=directory_path,
                parent_fd=directory_fd,
                filename=entry,
            )
            open_directory_fds.append(child_fd)
            _seal_final_log_tree(
                role=role,
                directory_name=f"{directory_name}/{entry}",
                directory_path=child_path,
                directory_fd=child_fd,
                parent_fd=directory_fd,
                filename=entry,
                relative_path=entry_relative_path,
                artifacts=artifacts,
                artifact_handles=artifact_handles,
                directory_handles=directory_handles,
                open_directory_fds=open_directory_fds,
            )
        else:
            raise ValueError(f"unsupported final log entry: {directory_path}/{entry}")

    os.fchmod(directory_fd, DIRECTORY_MODE)
    os.fsync(directory_fd)
    _require_exact_entries(
        directory_fd,
        path=directory_path,
        expected_entries=expected_entries,
    )
    identity = _directory_identity(directory_path, directory_fd)
    identity["name"] = directory_name
    identity["role"] = role
    identity["relative_path"] = relative_path or "."
    directory_handles.append(
        {
            "identity": identity,
            "directory_fd": directory_fd,
            "parent_fd": parent_fd,
            "filename": filename,
            "expected_entries": expected_entries,
        }
    )


def _verify_artifact_path(
    *,
    artifact: dict[str, object],
    filename: str,
    parent_fd: int,
    file_fd: int,
) -> None:
    sha256 = _sha256_fd(file_fd)
    path_stat = os.stat(filename, dir_fd=parent_fd, follow_symlinks=False)
    fd_stat = os.fstat(file_fd)
    expected = (
        artifact["device"],
        artifact["inode"],
        artifact["size"],
        artifact["mtime_ns"],
        artifact["mode"],
    )
    actual = (
        path_stat.st_dev,
        path_stat.st_ino,
        path_stat.st_size,
        path_stat.st_mtime_ns,
        _mode_string(path_stat.st_mode),
    )
    fd_actual = (
        fd_stat.st_dev,
        fd_stat.st_ino,
        fd_stat.st_size,
        fd_stat.st_mtime_ns,
        _mode_string(fd_stat.st_mode),
    )
    if actual != expected or fd_actual != expected or sha256 != artifact["sha256"]:
        raise RuntimeError(f"sealed runtime artifact identity changed: {artifact['path']}")


def _write_all(file_fd: int, payload: bytes) -> None:
    offset = 0
    while offset < len(payload):
        written = os.write(file_fd, payload[offset:])
        if written <= 0:
            raise OSError("short write while publishing runtime artifact manifest")
        offset += written


def _read_receipt(file_fd: int, *, path: object) -> str:
    receipt_stat = os.fstat(file_fd)
    if receipt_stat.st_size > 1024 * 1024:
        raise ValueError(f"runtime provenance receipt is unexpectedly large: {path}")
    os.lseek(file_fd, 0, os.SEEK_SET)
    payload = os.read(file_fd, receipt_stat.st_size + 1)
    if len(payload) != receipt_stat.st_size:
        raise RuntimeError(f"runtime provenance receipt changed while reading: {path}")
    try:
        return payload.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(f"runtime provenance receipt is not UTF-8: {path}") from error


def _validate_receipt_contents(
    *,
    artifact_handles: list[dict[str, object]],
    job_id: str,
    restart_count: int,
    session: str,
    expected_workers: int,
) -> list[tuple[str, str]]:
    handles_by_name = {handle["artifact"]["name"]: handle for handle in artifact_handles}
    final_log_roles: list[tuple[str, str]] = []

    def receipt(name: str) -> str:
        handle = handles_by_name[name]
        return _read_receipt(
            handle["file_fd"],
            path=handle["artifact"]["path"],
        )

    if receipt("session_name") != f"{session}\n":
        raise ValueError("RAY_SESSION_NAME does not match the manifest session")

    head_attestation = receipt("attestation/head")
    head_match = re.fullmatch(
        rf"role=head\nnode=([A-Za-z0-9][A-Za-z0-9._-]*)\nsession={re.escape(session)}\n",
        head_attestation,
    )
    if head_match is None:
        raise ValueError("head session attestation is malformed")
    head_node = head_match.group(1)
    final_log_roles.append(("head", head_node))
    expected_head_completion = (
        "schema=ray-session-completion-v1\n"
        "role=head\n"
        f"job_id={job_id}\n"
        f"restart_count={restart_count}\n"
        f"node={head_node}\n"
        f"session={session}\n"
        "exit_code=0\n"
        "sync=complete\n"
    )
    if receipt("completion/head") != expected_head_completion:
        raise ValueError("head completion receipt is malformed")

    for worker_index in range(expected_workers):
        worker_attestation = receipt(f"attestation/worker-{worker_index}")
        worker_match = re.fullmatch(
            rf"role=worker\nworker_index={worker_index}\n"
            rf"node=([A-Za-z0-9][A-Za-z0-9._-]*)\n"
            rf"session={re.escape(session)}\n",
            worker_attestation,
        )
        if worker_match is None:
            raise ValueError(f"worker {worker_index} session attestation is malformed")
        worker_node = worker_match.group(1)
        final_log_roles.append((f"worker-{worker_index}", worker_node))
        expected_worker_completion = (
            "schema=ray-session-completion-v1\n"
            "role=worker\n"
            f"worker_index={worker_index}\n"
            f"job_id={job_id}\n"
            f"restart_count={restart_count}\n"
            f"node={worker_node}\n"
            f"session={session}\n"
            "exit_code=0\n"
            "sync=complete\n"
        )
        if receipt(f"completion/worker-{worker_index}") != expected_worker_completion:
            raise ValueError(f"worker {worker_index} completion receipt is malformed")

    expected_job_completion = (
        "schema=ray-session-completion-v1\n"
        "role=job\n"
        f"job_id={job_id}\n"
        f"restart_count={restart_count}\n"
        f"session={session}\n"
        f"expected_workers={expected_workers}\n"
        "status=complete\n"
        "exit_code=0\n"
    )
    if receipt("job_completion") != expected_job_completion:
        raise ValueError("job completion receipt is malformed")
    return final_log_roles


def publish_manifest(argv: list[str]) -> None:
    if len(argv) != 7:
        raise ValueError(
            "usage: runtime_artifact_manifest.py " "LOG_DIR MANIFEST JOB_ID RESTART_COUNT SESSION EXPECTED_WORKERS"
        )

    log_dir = os.path.abspath(argv[1])
    manifest_path = os.path.abspath(argv[2])
    job_id = argv[3]
    restart_count = int(argv[4])
    session = argv[5]
    expected_workers = int(argv[6])
    if manifest_path != os.path.join(log_dir, "RAY_RUNTIME_ARTIFACTS.json"):
        raise ValueError(f"manifest path is outside the exact log directory: {manifest_path}")
    if not re.fullmatch(r"[0-9]+", job_id):
        raise ValueError(f"invalid Slurm job ID: {job_id!r}")
    if restart_count < 0:
        raise ValueError(f"invalid restart count: {restart_count}")
    if not SESSION_PATTERN.fullmatch(session):
        raise ValueError(f"invalid Ray session name: {session!r}")
    if expected_workers < 0:
        raise ValueError(f"invalid expected worker count: {expected_workers}")

    attestation_dir = os.path.join(log_dir, "RAY_SESSION_ATTESTATIONS")
    completion_dir = os.path.join(log_dir, "RAY_SESSION_COMPLETIONS")
    directory_fds: dict[str, int] = {}
    artifact_handles: list[dict[str, object]] = []
    final_log_directory_handles: list[dict[str, object]] = []
    final_log_open_fds: list[int] = []
    manifest_fd = -1
    manifest_published = False
    temp_name = f".RAY_RUNTIME_ARTIFACTS.json.{os.getpid()}.tmp"
    final_name = "RAY_RUNTIME_ARTIFACTS.json"
    original_log_mode = 0

    try:
        directory_fds["log_dir"] = _open_directory(log_dir)
        log_fd = directory_fds["log_dir"]
        original_log_mode = stat.S_IMODE(os.fstat(log_fd).st_mode)
        directory_fds["session_attestations"] = _open_directory(attestation_dir)
        directory_fds["session_completions"] = _open_directory(completion_dir)

        if _entry_exists(log_fd, final_name) or _entry_exists(log_fd, temp_name):
            raise FileExistsError(f"runtime artifact manifest already exists: {manifest_path}")

        worker_receipts = [f"worker-{worker_index}" for worker_index in range(expected_workers)]
        _require_exact_entries(
            directory_fds["session_attestations"],
            path=attestation_dir,
            expected_entries=["head", *worker_receipts],
        )
        _require_exact_entries(
            directory_fds["session_completions"],
            path=completion_dir,
            expected_entries=["head", *worker_receipts],
        )

        worker_log_width = len(str(expected_workers))
        worker_logs = [
            f"ray-worker-{worker_index:0{worker_log_width}d}.log" for worker_index in range(expected_workers)
        ]
        actual_worker_logs = sorted(
            entry for entry in os.listdir(log_fd) if re.fullmatch(r"ray-worker-.*[.]log", entry)
        )
        if actual_worker_logs != sorted(worker_logs):
            raise ValueError(
                "unexpected Ray worker log set: " f"expected={sorted(worker_logs)!r}, actual={actual_worker_logs!r}"
            )

        artifact_specs: list[tuple[str, str, str]] = [
            ("session_name", "log_dir", "RAY_SESSION_NAME"),
            ("attestation/head", "session_attestations", "head"),
        ]
        artifact_specs.extend(
            (
                f"attestation/worker-{worker_index}",
                "session_attestations",
                f"worker-{worker_index}",
            )
            for worker_index in range(expected_workers)
        )
        artifact_specs.append(("completion/head", "session_completions", "head"))
        artifact_specs.extend(
            (
                f"completion/worker-{worker_index}",
                "session_completions",
                f"worker-{worker_index}",
            )
            for worker_index in range(expected_workers)
        )
        artifact_specs.extend(
            [
                ("job_completion", "log_dir", "RAY_JOB_COMPLETION"),
                ("log/head", "log_dir", "ray-head.log"),
                ("log/driver", "log_dir", "ray-driver.log"),
            ]
        )
        artifact_specs.extend(
            (f"log/worker-{worker_index}", "log_dir", worker_log) for worker_index, worker_log in enumerate(worker_logs)
        )

        parent_paths = {
            "log_dir": log_dir,
            "session_attestations": attestation_dir,
            "session_completions": completion_dir,
        }
        artifacts: list[dict[str, object]] = []
        for artifact_name, directory_name, filename in artifact_specs:
            file_fd, artifact = _seal_artifact(
                artifact_name=artifact_name,
                filename=filename,
                parent_path=parent_paths[directory_name],
                parent_fd=directory_fds[directory_name],
            )
            artifacts.append(artifact)
            artifact_handles.append(
                {
                    "artifact": artifact,
                    "filename": filename,
                    "directory_name": directory_name,
                    "file_fd": file_fd,
                }
            )

        final_log_roles = _validate_receipt_contents(
            artifact_handles=artifact_handles,
            job_id=job_id,
            restart_count=restart_count,
            session=session,
            expected_workers=expected_workers,
        )

        worker_nodes = [node for role, node in final_log_roles if role != "head"]
        if len(set(worker_nodes)) != len(worker_nodes) or session in worker_nodes:
            raise ValueError("final Ray log roots are not uniquely attributable")
        final_ray_path = os.path.join(log_dir, "ray")
        final_ray_fd = _open_child_directory(
            parent_path=log_dir,
            parent_fd=log_fd,
            filename="ray",
        )
        final_log_open_fds.append(final_ray_fd)
        _require_exact_entries(
            final_ray_fd,
            path=final_ray_path,
            expected_entries=[session, *worker_nodes],
        )

        for role, node in final_log_roles:
            if role == "head":
                components = [("session", session), ("logs", "logs")]
            else:
                components = [("node", node), ("session", session), ("logs", "logs")]
            parent_path = final_ray_path
            parent_fd = final_ray_fd
            structural_handles: list[dict[str, object]] = []
            for component_index, (component_kind, component) in enumerate(components):
                child_path = os.path.join(parent_path, component)
                child_fd = _open_child_directory(
                    parent_path=parent_path,
                    parent_fd=parent_fd,
                    filename=component,
                )
                final_log_open_fds.append(child_fd)
                structural_handles.append(
                    {
                        "name": f"final_log/{role}/{component_kind}",
                        "role": role,
                        "component_kind": component_kind,
                        "path": child_path,
                        "directory_fd": child_fd,
                        "parent_fd": parent_fd,
                        "filename": component,
                    }
                )
                if component_index + 1 < len(components):
                    next_component = components[component_index + 1][1]
                    _require_exact_entries(
                        child_fd,
                        path=child_path,
                        expected_entries=[next_component],
                    )
                    structural_handles[-1]["expected_entries"] = [next_component]
                parent_path = child_path
                parent_fd = child_fd

            logs_handle = structural_handles.pop()
            _seal_final_log_tree(
                role=role,
                directory_name=logs_handle["name"],
                directory_path=logs_handle["path"],
                directory_fd=logs_handle["directory_fd"],
                parent_fd=logs_handle["parent_fd"],
                filename=logs_handle["filename"],
                relative_path="",
                artifacts=artifacts,
                artifact_handles=artifact_handles,
                directory_handles=final_log_directory_handles,
                open_directory_fds=final_log_open_fds,
            )
            for handle in reversed(structural_handles):
                os.fchmod(handle["directory_fd"], DIRECTORY_MODE)
                os.fsync(handle["directory_fd"])
                _require_exact_entries(
                    handle["directory_fd"],
                    path=handle["path"],
                    expected_entries=handle["expected_entries"],
                )
                identity = _directory_identity(handle["path"], handle["directory_fd"])
                identity["name"] = handle["name"]
                identity["role"] = handle["role"]
                identity["relative_path"] = f"<{handle['component_kind']}>"
                final_log_directory_handles.append(
                    {
                        "identity": identity,
                        "directory_fd": handle["directory_fd"],
                        "parent_fd": handle["parent_fd"],
                        "filename": handle["filename"],
                        "expected_entries": handle["expected_entries"],
                    }
                )

        os.fchmod(final_ray_fd, DIRECTORY_MODE)
        os.fsync(final_ray_fd)
        expected_final_ray_entries = [session, *worker_nodes]
        _require_exact_entries(
            final_ray_fd,
            path=final_ray_path,
            expected_entries=expected_final_ray_entries,
        )
        final_ray_identity = _directory_identity(final_ray_path, final_ray_fd)
        final_ray_identity["name"] = "final_log_root"
        final_ray_identity["role"] = "all"
        final_ray_identity["relative_path"] = "."
        final_log_directory_handles.append(
            {
                "identity": final_ray_identity,
                "directory_fd": final_ray_fd,
                "parent_fd": log_fd,
                "filename": "ray",
                "expected_entries": expected_final_ray_entries,
            }
        )

        for directory_name in ("session_attestations", "session_completions"):
            os.fchmod(directory_fds[directory_name], DIRECTORY_MODE)
            os.fsync(directory_fds[directory_name])

        directories = {
            "log_dir": {
                "path": log_dir,
                "mode": "0555",
                "device": os.fstat(log_fd).st_dev,
                "inode": os.fstat(log_fd).st_ino,
            },
            "session_attestations": _directory_identity(
                attestation_dir,
                directory_fds["session_attestations"],
            ),
            "session_completions": _directory_identity(
                completion_dir,
                directory_fds["session_completions"],
            ),
        }
        manifest = {
            "schema": SCHEMA,
            "manifest_path": manifest_path,
            "job_id": job_id,
            "restart_count": restart_count,
            "session": session,
            "expected_workers": expected_workers,
            "artifact_count": len(artifacts),
            "artifacts": artifacts,
            "directories": directories,
            "final_log_directory_count": len(final_log_directory_handles),
            "final_log_directories": [
                handle["identity"] for handle in final_log_directory_handles
            ],
            "integrity": {
                "artifact_mode": "0444",
                "artifacts_sealed": True,
                "artifacts_fsynced": True,
                "directory_mode": "0555",
                "directories_sealed": True,
                "directories_fsynced": True,
                "final_logs_inventoried": True,
                "final_logs_sealed": True,
                "manifest_mode": "0444",
                "manifest_sealed": True,
                "manifest_fsynced": True,
                "atomic_publish": True,
            },
        }
        payload = (json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8")

        manifest_fd = os.open(
            temp_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
            dir_fd=log_fd,
        )
        _write_all(manifest_fd, payload)
        os.fsync(manifest_fd)
        os.fchmod(manifest_fd, ARTIFACT_MODE)
        os.fsync(manifest_fd)
        os.rename(temp_name, final_name, src_dir_fd=log_fd, dst_dir_fd=log_fd)
        manifest_published = True

        os.fchmod(log_fd, DIRECTORY_MODE)
        os.fsync(log_fd)
        _verify_directory_path(
            identity=directories["log_dir"],
            directory_fd=log_fd,
        )
        _verify_directory_path(
            identity=directories["session_attestations"],
            directory_fd=directory_fds["session_attestations"],
            parent_fd=log_fd,
            filename="RAY_SESSION_ATTESTATIONS",
        )
        _verify_directory_path(
            identity=directories["session_completions"],
            directory_fd=directory_fds["session_completions"],
            parent_fd=log_fd,
            filename="RAY_SESSION_COMPLETIONS",
        )
        for handle in final_log_directory_handles:
            _verify_directory_path(
                identity=handle["identity"],
                directory_fd=handle["directory_fd"],
                parent_fd=handle["parent_fd"],
                filename=handle["filename"],
            )
            _require_exact_entries(
                handle["directory_fd"],
                path=handle["identity"]["path"],
                expected_entries=handle["expected_entries"],
            )

        for handle in artifact_handles:
            if "parent_fd" in handle:
                parent_fd = handle["parent_fd"]
            else:
                parent_fd = directory_fds[handle["directory_name"]]
            _verify_artifact_path(
                artifact=handle["artifact"],
                filename=handle["filename"],
                parent_fd=parent_fd,
                file_fd=handle["file_fd"],
            )
        manifest_stat = os.fstat(manifest_fd)
        if (
            not stat.S_ISREG(manifest_stat.st_mode)
            or _mode_string(manifest_stat.st_mode) != "0444"
            or manifest_stat.st_size != len(payload)
        ):
            raise RuntimeError("published runtime artifact manifest did not seal exactly")
    except (OSError, RuntimeError, TypeError, ValueError):
        log_fd = directory_fds.get("log_dir", -1)
        if log_fd >= 0:
            try:
                os.fchmod(log_fd, original_log_mode or 0o755)
                if manifest_published and _entry_exists(log_fd, final_name):
                    os.unlink(final_name, dir_fd=log_fd)
                elif _entry_exists(log_fd, temp_name):
                    os.unlink(temp_name, dir_fd=log_fd)
                if _entry_exists(log_fd, "RAY_JOB_COMPLETION"):
                    os.unlink("RAY_JOB_COMPLETION", dir_fd=log_fd)
                os.fsync(log_fd)
            except OSError as cleanup_error:
                print(
                    f"failed to remove incomplete runtime artifact manifest: {cleanup_error}",
                    file=sys.stderr,
                )
        raise
    finally:
        if manifest_fd >= 0:
            try:
                os.close(manifest_fd)
            except OSError:
                pass
        for handle in artifact_handles:
            try:
                os.close(handle["file_fd"])
            except OSError:
                pass
        for directory_fd in directory_fds.values():
            try:
                os.close(directory_fd)
            except OSError:
                pass
        for directory_fd in final_log_open_fds:
            try:
                os.close(directory_fd)
            except OSError:
                pass


if __name__ == "__main__":
    try:
        publish_manifest(sys.argv)
    except (OSError, RuntimeError, TypeError, ValueError) as error:
        print(f"runtime artifact manifest publication failed: {error}", file=sys.stderr)
        raise SystemExit(1)
# END RAY_RUNTIME_ARTIFACT_MANIFEST_HELPER
RUNTIME_ARTIFACT_MANIFEST_HELPER_EOF
chmod 500 "$RUNTIME_ARTIFACT_MANIFEST_HELPER"

publish-runtime-artifact-manifest() {
  local session_name="$1"
  local expected_workers="$2"
  run-final-sync-command "$RAY_FINAL_SYNC_WATCHDOG_SECONDS" \
    python3 "$RUNTIME_ARTIFACT_MANIFEST_HELPER" \
    "$LOG_DIR" \
    "$RAY_RUNTIME_ARTIFACT_MANIFEST" \
    "$SLURM_JOB_ID" \
    "$JOB_RESTART_COUNT" \
    "$session_name" \
    "$expected_workers"
}

# BEGIN RAY_WORKER_SESSION_LATEST_RESOLVER
# GNU readlink -f prints a normalized path and exits zero when only the final
# component is absent.  Workers intentionally remove session_latest before
# starting Ray, so -f turns that normal window into a false session mismatch.
# GNU readlink -e requires every component to exist.  Recheck the reserved leaf
# after resolution so concurrent creation/removal either waits or fails closed;
# a stable regular file/directory is never accepted as Ray's symlink.
resolve_ray_session_latest() {
  local latest_path="${1:?missing Ray session_latest path}"
  local resolved_path=""
  resolved_path=$(readlink -e -- "$latest_path" 2>/dev/null || true)
  if [[ -n "$resolved_path" ]]; then
    if [[ -L "$latest_path" ]]; then
      printf '%s\n' "$resolved_path"
      return 0
    fi
    # The symlink may have disappeared after readlink completed.  Treat a now
    # absent leaf as another wait iteration, not as a mismatched session.
    if [[ ! -e "$latest_path" && ! -L "$latest_path" ]]; then
      printf '\n'
      return 0
    fi
    return 2
  fi
  if [[ -e "$latest_path" && ! -L "$latest_path" ]]; then
    return 2
  fi
  printf '\n'
}
# END RAY_WORKER_SESSION_LATEST_RESOLVER
readonly RAY_WORKER_SESSION_LATEST_RESOLVER="$(declare -f resolve_ray_session_latest)"

# Set up the sandbox ports/signal directory on the shared FS before building the
# head script, so the head can gate the driver on sandbox readiness. Arbitrary
# extra mounts are supported via SANDBOX_EXTRA_MOUNTS (e.g. a shared temp dir).
SANDBOX_PORTS_DIR=""
if [[ -n "${SANDBOX_CONTAINER:-}" ]] && [[ -n "${SANDBOX_COMMAND:-}" ]]; then
  SANDBOX_PORTS_DIR="$LOG_DIR/sandbox"
  mkdir -p "$SANDBOX_PORTS_DIR"
fi

# First we start the head of the ray cluster on one of the physical nodes
# Give the head node actual resources to make it schedulable

head_cmd=$(cat <<EOF
if [[ "\${RAY_SUB_DEBUG_ENV:-0}" == "1" ]]; then
  env | grep -viE '(WANDB_API_KEY|HF_TOKEN|API_KEY|TOKEN|SECRET|PASSWORD)=' || true
fi

# Turn on pipefail here; it does not carry into this 'bash -c' subshell from the
# submit host. Without it, 'ray status | grep worker_units | awk ...' exits 0 even
# when grep matches nothing (awk's status wins), so the '|| echo 0' fallback never
# fires. Do NOT add 'set -e': the retry loops and '-eq' polls below need non-zero
# exit codes to stay non-fatal.
set -o pipefail

# If this node can't see the canary, LOG_DIR is not shared. Fail now instead of
# waiting forever for signal files the submit host writes but this node can't read.
if [[ ! -f "$LOG_DIR/.shared_fs_canary" ]]; then
  echo "[ERROR] $LOG_DIR/.shared_fs_canary not visible on the head node; LOG_DIR must be on a shared filesystem." >&2
  touch "$LOG_DIR/ENDED" 2>/dev/null || true
  exit 1
fi

# Phase markers inside the container; reuse the propagated job-start epoch so the
# elapsed counter shares the submit-side timeline.
log_phase() { local t0="\${NRL_JOB_START_EPOCH:-0}"; echo "[NRL_PHASE][\$(date '+%Y-%m-%dT%H:%M:%S%z')][+\$(( \$(date +%s) - \${t0%.*} ))s] \$*"; }
log_phase "head container started on \$(hostname)"
NRL_PROVENANCE_LOG_DIR="$LOG_DIR"
source "$FINAL_SYNC_HELPER_SCRIPT"

exit-dramatically() {
    # Use SIGTERM to forcefully terminate the srun process
    pkill -P $$ || true
    kill -TERM 0 || true
    # As a last resort, exit with a non-zero code
    exit 1
}

# These functions run as background children of this shell.  Keep their PIDs so
# the finalizer can reap them before Pyxis tears down the container namespace;
# exported shell functions are neither needed nor safe to leak into Ray actors.
monitor_sidecar_pid=""
log_sync_sidecar_pid=""
ray_status_sidecar_pid=""

# Background process to check for ENDED file
monitor-sidecar() {
  set +x
  while true; do
    sleep 1
    if [[ -f "$LOG_DIR/ENDED" ]]; then
      echo "Detected ENDED file, terminating..."
      exit-dramatically
    fi
  done
}
monitor-sidecar &
monitor_sidecar_pid=\$!

# Periodic copies are diagnostics only and never overlap the evaluator-visible
# final tree. The finalizer below atomically publishes ray/<session>/logs.
sync-live-session-logs() {
  if [[ ! -s "$LOG_DIR/RAY_SESSION_NAME" ]]; then
    return 1
  fi
  local session_name source_logs live_logs
  session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
  source_logs="/tmp/ray/\$session_name/logs"
  live_logs="$LOG_DIR/ray_live/head/\$session_name/logs"
  sync-live-ray-logs "\$source_logs" "\$live_logs"
}

atomic-final-head-logs() {
  local session_name source_logs final_logs
  session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
  source_logs="/tmp/ray/\$session_name/logs"
  final_logs="$LOG_DIR/ray/\$session_name/logs"
  atomic-final-ray-logs \
    "\$source_logs" "\$final_logs" head "$RAY_FINAL_SYNC_WATCHDOG_SECONDS"
}

write-head-completion-receipt() {
  local rc="\$1"
  local session_name="\$2"
  atomic-write-provenance-file "$RAY_SESSION_COMPLETION_DIR/head" <<HEAD_COMPLETION_EOF
schema=ray-session-completion-v1
role=head
job_id=$SLURM_JOB_ID
restart_count=$JOB_RESTART_COUNT
node=\$head_node_name
session=\$session_name
exit_code=\$rc
sync=complete
HEAD_COMPLETION_EOF
}

write-worker-finalize-request-from-head() {
  local session_name="\$1"
  atomic-write-provenance-file "$WORKER_FINALIZE_REQUEST" <<HEAD_WORKER_FINALIZE_EOF
schema=ray-session-completion-v1
job_id=$SLURM_JOB_ID
restart_count=$JOB_RESTART_COUNT
session=\$session_name
action=finalize-workers
HEAD_WORKER_FINALIZE_EOF
}

# Background process to sync ray logs every $RAY_LOG_SYNC_FREQUENCY seconds.
log-sync-sidecar() {
  set +x
  if [[ -z "$RAY_LOG_SYNC_FREQUENCY" ]]; then
    echo "RAY_LOG_SYNC_FREQUENCY is not set, skipping periodic log sync"
    return
  fi
  while true; do
    sleep $RAY_LOG_SYNC_FREQUENCY
    sync-live-session-logs || true
    if [[ -f "$LOG_DIR/ENDED" ]]; then
      echo "Log sync sidecar terminating..."
      break
    fi
  done
}
log-sync-sidecar &
log_sync_sidecar_pid=\$!

stop-head-sidecars() {
  local sidecar_pids=(
    "\${monitor_sidecar_pid:-}"
    "\${log_sync_sidecar_pid:-}"
    "\${ray_status_sidecar_pid:-}"
  )
  stop-background-processes 10 "head sidecars" TERM KILL 0 "\${sidecar_pids[@]}"
}

# The driver can exit between periodic syncs. Always copy the authenticated
# session once more before the head shell leaves the allocation.
finalize-head-log-sync() {
  local rc="\$1"
  local final_rc="\$rc"
  local session_name expected_attestation
  local provenance_valid=0
  local ray_quiesced=0
  trap - EXIT
  trap '' TERM HUP INT USR1
  if [[ -s "$LOG_DIR/RAY_SESSION_NAME" ]] && [[ -n "\${head_node_name:-}" ]]; then
    session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
    expected_attestation=\$(printf 'role=head\nnode=%s\nsession=%s' \
      "\$head_node_name" "\$session_name")
    if [[ "\$session_name" =~ ^session_[A-Za-z0-9._-]+$ ]] && \
       provenance-file-matches \
         "$LOG_DIR/RAY_SESSION_ATTESTATIONS/head" "\$expected_attestation"; then
      provenance_valid=1
    fi
  fi
  if [[ "\$provenance_valid" -ne 1 ]]; then
    echo "[ERROR] Head exited before session provenance was established" >&2
    [[ "\$final_rc" -ne 0 ]] || final_rc=1
  fi

  # Authorize worker shutdown only after a successful driver exit and verified
  # head/session provenance. Publish the request before ENDED so workers can
  # distinguish controlled finalization from error shutdown.
  if [[ "\$rc" -eq 0 ]] && [[ "\$provenance_valid" -eq 1 ]]; then
    if ! write-worker-finalize-request-from-head "\$session_name"; then
      echo "[ERROR] Head failed to publish authenticated worker final-sync request" >&2
      final_rc=1
    fi
  fi
  if ! touch "$LOG_DIR/ENDED"; then
    echo "[ERROR] Head failed to publish finalization signal" >&2
    [[ "\$final_rc" -ne 0 ]] || final_rc=1
  fi

  # ENDED is the submit-side finalization-start marker. Publish it before any
  # cleanup that could block so the outer watchdog bounds this whole phase.
  if ! stop-head-sidecars; then
    echo "[ERROR] Head sidecars required forced cleanup" >&2
    [[ "\$final_rc" -ne 0 ]] || final_rc=1
  fi

  # Ray daemons write their own logs after the driver exits. Quiesce them under
  # the same bounded policy as the final copy; never stamp sync=complete for a
  # source tree that may still be mutating.
  if run-final-sync-command \
       "$RAY_FINAL_SYNC_WATCHDOG_SECONDS" ray stop; then
    ray_quiesced=1
  else
    echo "[ERROR] Head failed to quiesce Ray before final log publication" >&2
    [[ "\$final_rc" -ne 0 ]] || final_rc=1
  fi

  if [[ "\$provenance_valid" -eq 1 ]] && [[ "\$ray_quiesced" -eq 1 ]]; then
    if atomic-final-head-logs && \
       write-head-completion-receipt "\$final_rc" "\$session_name"; then
      :
    else
      echo "[ERROR] Head failed to publish atomic final logs/completion receipt" >&2
      [[ "\$final_rc" -ne 0 ]] || final_rc=1
    fi
  fi
  exit "\$final_rc"
}
trap 'finalize-head-log-sync \$?' EXIT
trap 'finalize-head-log-sync 143' TERM
trap 'finalize-head-log-sync 129' HUP
trap 'finalize-head-log-sync 130' INT
trap 'finalize-head-log-sync 143' USR1

# Background process that publishes the live worker_units count to a file on the
# shared FS, which the submit host reads to track how many workers have joined.
ray-status-sidecar() {
  set +x
  while true; do
    sleep 10
    units=\$(ray status 2>/dev/null | grep "worker_units" | awk -F'[/. ]' '{print \$4}' || echo 0)
    # Write to a temp file, then rename. A plain '>' truncates before writing, so the
    # submit host (reading this over the shared FS from another node) could catch it
    # empty or half-written. rename is atomic: the reader always gets either the old
    # value or the full new one.
    echo "\$units" > "$LOG_DIR/.ray_worker_units.tmp"
    mv "$LOG_DIR/.ray_worker_units.tmp" "$LOG_DIR/ray_worker_units"
    if [[ -f "$LOG_DIR/ENDED" ]]; then break; fi
  done
}
ray-status-sidecar &
ray_status_sidecar_pid=\$!

# Patch nsight.py before starting Ray head
sed -i 's/context\.py_executable = " "\.join(self\.nsight_cmd) + " python"/context.py_executable = " ".join(self.nsight_cmd) + f" {context.py_executable}"/g' /opt/nemo_rl_venv/lib64/python*/site-packages/ray/_private/runtime_env/nsight.py

# Keeps model, generation, teacher, and Gym GPU actors off the Ray head. The
# resource JSON itself is built by topology_probe.sh so head and workers keep a
# single construction site.
export NRL_DEDICATED_RAY_HEAD=$DEDICATED_RAY_HEAD

source $LOG_DIR/topology_probe.sh

HEAD_RAY_RESOURCE_ARGS=""
if [[ "$DEDICATED_RAY_HEAD" == "1" ]]; then
  HEAD_RAY_RESOURCE_ARGS="--num-gpus=0"
  echo "[INFO] Dedicated Ray head enabled: advertising zero GPUs and no worker_units"
fi

# Clear MPI/PMIx/SLURM env vars inherited from the srun launcher so TRT-LLM's
# MPI_Init (in the ray daemon child process below) starts clean.
# NOTE: keep this after topology_probe.sh, which reads SLURM_TOPOLOGY_ADDR/SLURM_PROCID.
for v in \$(env | awk -F= '/^(PMI|PMIX|MPI|OMPI|SLURM)_/{print \$1}'); do
    unset "\$v"
done

# Start the head without --block. 'ray start --head' then returns as soon as the
# GCS is listening, so we touch STARTED_RAY_HEAD only after the head is actually up.
# Workers gate on that file, so they only try to connect once the GCS is accepting
# connections.
log_phase "head: starting Ray head"
count=0
while [[ \$count -lt $num_retries ]]; do
  # Clean up stale Ray state before every attempt. A timed-out attempt leaves a
  # session directory behind, and the next 'ray start --head' would otherwise hit:
  #   AssertionError: Session name ... does not match persisted value ...
  ray stop || true
  rm -rf /tmp/ray/session_* || true

  if [[ -n "$SETUP_COMMAND_FILE" ]] && [[ -f "$SETUP_COMMAND_FILE" ]]; then
    echo "[INFO] Running setup command from $SETUP_COMMAND_FILE..."
    bash "$SETUP_COMMAND_FILE"
  fi
  if cat <<EOFINNER | bash; then
ray start --head \
    --disable-usage-stats \
    --resources="\$RAY_RESOURCES" \
    \$HEAD_RAY_RESOURCE_ARGS \
    --node-ip-address="$head_node_ip" \
    --port=${PORT} \
    --ray-client-server-port=${RAY_CLIENT_SERVER_PORT} \
    --dashboard-port=${DASHBOARD_PORT} \
    --dashboard-host="$head_node_ip" \
    --include-dashboard=True \
    --min-worker-port=${MIN_WORKER_PORT} \
    --max-worker-port=${MAX_WORKER_PORT} \
    \
    --node-manager-port=$((${NODE_MANAGER_PORT} + 1)) \
    --object-manager-port=$((${OBJECT_MANAGER_PORT} + 1)) \
    --runtime-env-agent-port=$((${RUNTIME_ENV_AGENT_PORT} + 1)) \
    --dashboard-agent-grpc-port=$((${DASHBOARD_AGENT_GRPC_PORT} + 1)) \
    --dashboard-agent-listen-port=$((${DASHBOARD_AGENT_LISTEN_PORT} + 1)) \
    --metrics-export-port=$((${METRICS_EXPORT_PORT} + 1)) \
    $RAY_DEBUGGER_ARGS
EOFINNER
    echo "[INFO] Ray head started successfully (attempt \$((count+1))/$num_retries)"
    break
  fi
  count=\$((count+1))
  echo "[WARN] Head node failed \$count/$num_retries times, restarting in 5 seconds..."
  sleep 5
done
if [[ \$count -ge $num_retries ]]; then
  touch "$LOG_DIR/ENDED"
  exit 1
fi

# Publish the one Ray session this job owns before any worker is allowed to
# connect. Log sidecars read only this atomic manifest, so stale /tmp/ray
# sessions from an earlier allocation can never enter this job's evidence tree.
ray_session_path=\$(readlink -f /tmp/ray/session_latest)
ray_session_name=\$(basename "\$ray_session_path")
if [[ ! "\$ray_session_name" =~ ^session_[A-Za-z0-9._-]+$ ]] || \
   [[ "\$ray_session_path" != "/tmp/ray/\$ray_session_name" ]] || \
   [[ ! -d "\$ray_session_path/logs" ]]; then
  echo "[ERROR] Ray head did not publish a valid session directory: \$ray_session_path" >&2
  touch "$LOG_DIR/ENDED"
  exit 1
fi
printf '%s\n' "\$ray_session_name" > "$LOG_DIR/.RAY_SESSION_NAME.tmp"
mv "$LOG_DIR/.RAY_SESSION_NAME.tmp" "$LOG_DIR/RAY_SESSION_NAME"

# Attest the head node only after its canonical local session agrees with the
# published manifest. The role-specific filename and atomic rename let the
# strict evaluator distinguish this copy from worker mirrors of the same session.
ray_attestation_dir="$LOG_DIR/RAY_SESSION_ATTESTATIONS"
mkdir -p "\$ray_attestation_dir"
head_node_name=\$(hostname)
{
  printf 'role=head\n'
  printf 'node=%s\n' "\$head_node_name"
  printf 'session=%s\n' "\$ray_session_name"
} > "\$ray_attestation_dir/.head.\$\$.tmp"
mv "\$ray_attestation_dir/.head.\$\$.tmp" "\$ray_attestation_dir/head"

# Preserve an early diagnostic copy for jobs shorter than one periodic interval.
# It remains outside the strict evaluator's authenticated final tree.
sync-live-session-logs || true

# Signal workers and the submit host that the Ray head GCS and its authenticated
# session manifest/attestation are now available.
touch $LOG_DIR/STARTED_RAY_HEAD
log_phase "head: Ray GCS listening (STARTED_RAY_HEAD written)"

if [[ -n "$DRIVER_COMMAND_FILE" ]]; then
  # Non-interactive: wait for all workers to connect and, if a sandbox is
  # configured, for every sandbox instance to be ready, then run the driver. Poll
  # both in one loop with separate deadlines, checking the shorter sandbox deadline
  # first, so a stuck sandbox fails at 10 min instead of only after the 30-min
  # worker wait.
  WORKER_DEADLINE=\$((SECONDS + 1800))
  SANDBOX_DEADLINE=\$((SECONDS + 600))
  workers_ready=0
  # Each sandbox task touches SANDBOX_READY_<hostname> when its port comes up (see
  # the sandbox srun below). With no sandbox configured, count it ready up front.
  if [[ -n "$SANDBOX_PORTS_DIR" ]]; then sandbox_ready=0; else sandbox_ready=1; fi
  while true; do
    if [[ "\$workers_ready" -eq 0 ]]; then
      worker_units=\$(ray status 2>/dev/null | grep "worker_units" | awk -F'[/. ]' '{print \$4}' || echo 0)
      echo "[INFO][\$(date '+%Y-%m-%dT%H:%M:%S%z')] Number of actors online: \$worker_units/$NUM_ACTORS"
      if [[ "\$worker_units" -eq "$NUM_ACTORS" ]]; then
        workers_ready=1
        echo "[INFO][\$(date '+%Y-%m-%dT%H:%M:%S%z')] All workers connected!"
      fi
    fi
    if [[ "\$sandbox_ready" -eq 0 ]]; then
      ready_count=\$(ls -1 "$SANDBOX_PORTS_DIR"/SANDBOX_READY_* 2>/dev/null | wc -l)
      echo "[INFO][\$(date '+%Y-%m-%dT%H:%M:%S%z')] Sandbox ready on \$ready_count/$SLURM_JOB_NUM_NODES nodes..."
      if [[ "\$ready_count" -ge "$SLURM_JOB_NUM_NODES" ]]; then
        sandbox_ready=1
        echo "[INFO][\$(date '+%Y-%m-%dT%H:%M:%S%z')] All $SLURM_JOB_NUM_NODES sandbox instances ready."
      fi
    fi
    if [[ "\$workers_ready" -eq 1 ]] && [[ "\$sandbox_ready" -eq 1 ]]; then
      break
    fi
    if [[ "\$sandbox_ready" -eq 0 ]] && (( SECONDS > SANDBOX_DEADLINE )); then
      echo "[ERROR] Timed out waiting for sandbox (\$ready_count/$SLURM_JOB_NUM_NODES after 10 min)"
      touch "$LOG_DIR/ENDED"
      exit 1
    fi
    if [[ "\$workers_ready" -eq 0 ]] && (( SECONDS > WORKER_DEADLINE )); then
      echo "[ERROR] Timed out waiting for all workers to connect (\$worker_units/$NUM_ACTORS after 30 min)"
      touch "$LOG_DIR/ENDED"
      exit 1
    fi
    sleep 5
  done

  # Record the wall-clock epoch when the Ray cluster became ready so the driver
  # and training process can measure post-ready initialization timing.
  export NRL_RAY_READY_EPOCH=\$(date +%s.%N)

  log_phase "head: cluster ready, launching driver"
  set +e
  bash "$DRIVER_COMMAND_FILE" > "$LOG_DIR/ray-driver.log" 2>&1
  exit_code=\$?
  set -e
  exit \$exit_code
else
  # Interactive: keep the head container alive for user attachment via the attach
  # helper (a separate overlapping srun). sleep infinity is invisible to the
  # attached session.
  sleep infinity
fi
EOF
)

# Worker nodes connect to the head. They're launched with a single batched srun
# below; each task discovers its identity at runtime via SLURM_PROCID/SLURMD_NODENAME.
worker_cmd=$(cat <<EOF
if [[ "\${RAY_SUB_DEBUG_ENV:-0}" == "1" ]]; then
  env | grep -viE '(WANDB_API_KEY|HF_TOKEN|API_KEY|TOKEN|SECRET|PASSWORD)=' || true
fi
$RAY_WORKER_SESSION_LATEST_RESOLVER
echo "[INFO] Worker \$SLURM_PROCID on node \$SLURMD_NODENAME"

# Preserve worker identity before the MPI/SLURM environment cleanup below. The
# worker srun has one task per node, so SLURM_PROCID is the stable worker index.
WORKER_PROCID="\${SLURM_PROCID:?missing SLURM_PROCID}"
WORKER_NODE="\${SLURMD_NODENAME:?missing SLURMD_NODENAME}"
WORKER_SESSION_PROBE_READY="/tmp/nrl_ray_session_probe_\${SLURM_JOB_ID:?missing SLURM_JOB_ID}_\${WORKER_PROCID}"
rm -f "\$WORKER_SESSION_PROBE_READY"

# Fail fast if LOG_DIR is not actually shared with the submit host -- the worker
# gates on STARTED_RAY_HEAD and other signal files that would otherwise never appear.
if [[ ! -f "$LOG_DIR/.shared_fs_canary" ]]; then
  echo "[ERROR] Worker \$SLURM_PROCID: $LOG_DIR/.shared_fs_canary not visible; LOG_DIR must be on a shared filesystem." >&2
  exit 1
fi

# Phase markers inside the container (see head container).
log_phase() { local t0="\${NRL_JOB_START_EPOCH:-0}"; echo "[NRL_PHASE][\$(date '+%Y-%m-%dT%H:%M:%S%z')][+\$(( \$(date +%s) - \${t0%.*} ))s] \$*"; }
log_phase "worker \$SLURM_PROCID container started on \$(hostname)"
NRL_PROVENANCE_LOG_DIR="$LOG_DIR"
source "$FINAL_SYNC_HELPER_SCRIPT"

exit-dramatically() {
    # Use SIGTERM to forcefully terminate the srun process
    pkill -P $$ || true
    kill -TERM 0 || true
    # As a last resort, exit with a non-zero code
    exit 1
}

worker_monitor_sidecar_pid=""
worker_log_sync_sidecar_pid=""

# Background process to check for ENDED file
monitor-sidecar() {
  set +x
  while true; do
    if [[ -f "$LOG_DIR/ENDED" ]]; then
      echo "Detected ENDED file, stopping local Ray cleanly..."
      ray stop || true
      return
    fi
    sleep 1
  done
}
monitor-sidecar &
worker_monitor_sidecar_pid=\$!

# Periodic diagnostic copies live outside the authenticated final tree.
sync-live-session-logs() {
  if [[ ! -s "$LOG_DIR/RAY_SESSION_NAME" ]]; then
    return 1
  fi
  local session_name source_logs live_logs
  session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
  source_logs="/tmp/ray/\$session_name/logs"
  live_logs="$LOG_DIR/ray_live/worker-\$WORKER_PROCID/\$session_name/logs"
  sync-live-ray-logs "\$source_logs" "\$live_logs"
}

atomic-final-worker-logs() {
  local session_name source_logs final_logs
  session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
  source_logs="/tmp/ray/\$session_name/logs"
  final_logs="$LOG_DIR/ray/\$WORKER_NODE/\$session_name/logs"
  atomic-final-ray-logs \
    "\$source_logs" "\$final_logs" "worker-\$WORKER_PROCID" \
    "$RAY_FINAL_SYNC_WATCHDOG_SECONDS"
}

write-worker-completion-receipt() {
  local rc="\$1"
  local session_name="\$2"
  atomic-write-provenance-file \
    "$RAY_SESSION_COMPLETION_DIR/worker-\$WORKER_PROCID" <<WORKER_COMPLETION_EOF
schema=ray-session-completion-v1
role=worker
worker_index=\$WORKER_PROCID
job_id=$SLURM_JOB_ID
restart_count=$JOB_RESTART_COUNT
node=\$WORKER_NODE
session=\$session_name
exit_code=\$rc
sync=complete
WORKER_COMPLETION_EOF
}

controlled-worker-finalize-request-valid() {
  local session_name expected
  [[ -s "$LOG_DIR/RAY_SESSION_NAME" ]] || return 1
  session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
  expected=\$(printf \
    'schema=ray-session-completion-v1\njob_id=%s\nrestart_count=%s\nsession=%s\naction=finalize-workers' \
    '$SLURM_JOB_ID' '$JOB_RESTART_COUNT' "\$session_name")
  provenance-file-matches "$WORKER_FINALIZE_REQUEST" "\$expected"
}

# Fail closed unless this node creates the exact cluster session named by the
# head. The ready file prevents a stale pre-cleanup session_latest symlink from
# being inspected before the worker retry loop removes /tmp/ray/session_*.
log-sync-sidecar() {
  set +x
  local deadline expected_session local_session_path local_session_name
  local attestation_dir attestation_file attestation_tmp
  while [[ ! -f "\$WORKER_SESSION_PROBE_READY" ]]; do
    if [[ -f "$LOG_DIR/ENDED" ]]; then
      return
    fi
    sleep 1
  done

  deadline=\$((SECONDS + $RAY_SESSION_ATTEST_TIMEOUT))
  expected_session=\$(<"$LOG_DIR/RAY_SESSION_NAME")
  while true; do
    if ! local_session_path=\$(resolve_ray_session_latest /tmp/ray/session_latest); then
      echo "[ERROR] Worker \$WORKER_PROCID found a non-symlink at reserved path /tmp/ray/session_latest" >&2
      touch "$LOG_DIR/ENDED"
      exit-dramatically
    fi
    if [[ -n "\$local_session_path" ]]; then
      local_session_name=\$(basename "\$local_session_path")
      if [[ "\$local_session_name" != "\$expected_session" ]] || \
         [[ "\$local_session_path" != "/tmp/ray/\$expected_session" ]]; then
        echo "[ERROR] Worker \$WORKER_PROCID Ray session mismatch: expected /tmp/ray/\$expected_session, got \$local_session_path" >&2
        touch "$LOG_DIR/ENDED"
        exit-dramatically
      fi
      if [[ -d "\$local_session_path/logs" ]]; then
        break
      fi
    fi
    if (( SECONDS > deadline )); then
      echo "[ERROR] Worker \$WORKER_PROCID timed out waiting for Ray session \$expected_session" >&2
      touch "$LOG_DIR/ENDED"
      exit-dramatically
    fi
    sleep 1
  done

  attestation_dir="$LOG_DIR/RAY_SESSION_ATTESTATIONS"
  attestation_file="\$attestation_dir/worker-\$WORKER_PROCID"
  attestation_tmp="\$attestation_dir/.worker-\$WORKER_PROCID.\$\$.tmp"
  mkdir -p "\$attestation_dir"
  {
    printf 'role=worker\n'
    printf 'worker_index=%s\n' "\$WORKER_PROCID"
    printf 'node=%s\n' "\$WORKER_NODE"
    printf 'session=%s\n' "\$expected_session"
  } > "\$attestation_tmp"
  mv "\$attestation_tmp" "\$attestation_file"

  # The first copy proves this attested node produced the expected directory;
  # the main-shell exit trap performs one last copy after training.
  sync-live-session-logs || true
  if [[ -z "$RAY_LOG_SYNC_FREQUENCY" ]]; then
    echo "RAY_LOG_SYNC_FREQUENCY is not set, skipping periodic log sync"
    return
  fi
  while true; do
    sleep $RAY_LOG_SYNC_FREQUENCY
    sync-live-session-logs || true
    if [[ -f "$LOG_DIR/ENDED" ]]; then
      echo "Log sync sidecar terminating..."
      break
    fi
  done
}
log-sync-sidecar &
worker_log_sync_sidecar_pid=\$!

stop-worker-sidecars() {
  local sidecar_pids=(
    "\${worker_monitor_sidecar_pid:-}"
    "\${worker_log_sync_sidecar_pid:-}"
  )
  stop-background-processes 10 "worker sidecars" TERM KILL 0 "\${sidecar_pids[@]}"
}

finalize-worker-log-sync() {
  local rc="\$1"
  local final_rc="\$rc"
  local session_name expected_attestation local_session_path
  local provenance_valid=0
  local ray_quiesced=0
  trap - EXIT
  trap '' TERM HUP INT USR1
  if ! stop-worker-sidecars; then
    echo "[ERROR] Worker \$WORKER_PROCID sidecars required forced cleanup" >&2
    [[ "\$final_rc" -ne 0 ]] || final_rc=1
  fi
  if [[ -s "$LOG_DIR/RAY_SESSION_NAME" ]]; then
    session_name=\$(<"$LOG_DIR/RAY_SESSION_NAME")
    local_session_path=\$(resolve_ray_session_latest /tmp/ray/session_latest || true)
    expected_attestation=\$(printf \
      'role=worker\nworker_index=%s\nnode=%s\nsession=%s' \
      "\$WORKER_PROCID" "\$WORKER_NODE" "\$session_name")
    if [[ "\$local_session_path" == "/tmp/ray/\$session_name" ]] && \
       [[ -d "\$local_session_path/logs" ]] && \
       provenance-file-matches \
         "$LOG_DIR/RAY_SESSION_ATTESTATIONS/worker-\$WORKER_PROCID" \
         "\$expected_attestation"; then
      provenance_valid=1
    else
      echo "[ERROR] Worker \$WORKER_PROCID exited without valid local session provenance" >&2
      [[ "\$final_rc" -ne 0 ]] || final_rc=1
    fi
  else
    echo "[ERROR] Worker \$WORKER_PROCID exited before session provenance was established" >&2
    [[ "\$final_rc" -ne 0 ]] || final_rc=1
  fi

  # The monitor sidecar normally stops Ray after ENDED, but the main ray-start
  # blocking command can return first when the head/GCS disappears. Independently
  # quiesce this authenticated local session after reaping sidecars so no daemon
  # can still mutate the source while the final snapshot is copied.
  if [[ "\$provenance_valid" -eq 1 ]]; then
    if run-final-sync-command \
         "$RAY_FINAL_SYNC_WATCHDOG_SECONDS" ray stop; then
      ray_quiesced=1
    else
      echo "[ERROR] Worker \$WORKER_PROCID failed to quiesce Ray before final log publication" >&2
      [[ "\$final_rc" -ne 0 ]] || final_rc=1
    fi
  fi

  if [[ "\$provenance_valid" -eq 1 ]] && [[ "\$ray_quiesced" -eq 1 ]]; then
    if atomic-final-worker-logs && \
       write-worker-completion-receipt "\$rc" "\$session_name"; then
      :
    else
      echo "[ERROR] Worker \$WORKER_PROCID failed to publish atomic final logs/completion receipt" >&2
      [[ "\$final_rc" -ne 0 ]] || final_rc=1
    fi
  fi
  rm -f "\$WORKER_SESSION_PROBE_READY"
  exit "\$final_rc"
}
trap 'finalize-worker-log-sync \$?' EXIT
trap 'finalize-worker-log-sync 143' TERM
trap 'finalize-worker-log-sync 129' HUP
trap 'finalize-worker-log-sync 130' INT
trap 'finalize-worker-log-sync 143' USR1

# Patch nsight.py before starting Ray worker
sed -i 's/context\.py_executable = " "\.join(self\.nsight_cmd) + " python"/context.py_executable = " ".join(self.nsight_cmd) + f" {context.py_executable}"/g' /opt/nemo_rl_venv/lib64/python*/site-packages/ray/_private/runtime_env/nsight.py

source $LOG_DIR/topology_probe.sh

# Clear MPI/PMIx/SLURM env vars inherited from the srun launcher so TRT-LLM's
# MPI_Init (in the ray daemon child process below) starts clean.
# NOTE: keep this after topology_probe.sh, which reads SLURM_TOPOLOGY_ADDR/SLURM_PROCID.
for v in \$(env | awk -F= '/^(PMI|PMIX|MPI|OMPI|SLURM)_/{print \$1}'); do
    unset "\$v"
done

# Wait for the head to signal that its GCS is listening before connecting.
echo "[INFO] Worker \$SLURM_PROCID: waiting for Ray head GCS to be ready..."
while true; do
  if [[ -f "$LOG_DIR/STARTED_RAY_HEAD" ]]; then
    log_phase "worker \$SLURM_PROCID connecting to Ray head"
    break
  fi
  if [[ -f "$LOG_DIR/ENDED" ]]; then
    echo "[ERROR] ENDED detected before head started, exiting."
    exit 1
  fi
  sleep 5
done

# Workers retry more often and wait longer than the head. 'ray start --address'
# fails until the head GCS is listening, so a worker may have to outlast a slow head
# bringup: WORKER_NUM_RETRIES x 10s gives it ~200s. The head only retries a local
# 'ray start --head' a few times.
count=0
while [[ \$count -lt $WORKER_NUM_RETRIES ]]; do
  # Clean up stale Ray state before every attempt so a half-started raylet from a
  # previous attempt doesn't block the next one.
  ray stop || true
  rm -rf /tmp/ray/session_* || true

  if [[ -n "$SETUP_COMMAND_FILE" ]] && [[ -f "$SETUP_COMMAND_FILE" ]]; then
    echo "[INFO] Running setup command from $SETUP_COMMAND_FILE..."
    bash "$SETUP_COMMAND_FILE"
  fi
  # The provenance sidecar may inspect session_latest only after this attempt's
  # stale-state cleanup and setup have completed.
  touch "\$WORKER_SESSION_PROBE_READY"
  echo "[INFO][\$(date '+%Y-%m-%dT%H:%M:%S%z')] Worker \$SLURM_PROCID: starting Ray worker (attempt \$((count+1))/$WORKER_NUM_RETRIES)..."
  cat <<EOFINNER | bash
ray start --address "$ip_head" \
          --disable-usage-stats \
          --resources="\$RAY_RESOURCES" \
          --min-worker-port=${MIN_WORKER_PORT} \
          --max-worker-port=${MAX_WORKER_PORT} \
          \
          --node-manager-port=${NODE_MANAGER_PORT} \
          --object-manager-port=${OBJECT_MANAGER_PORT} \
          --runtime-env-agent-port=${RUNTIME_ENV_AGENT_PORT} \
          --dashboard-agent-grpc-port=${DASHBOARD_AGENT_GRPC_PORT} \
          --dashboard-agent-listen-port=${DASHBOARD_AGENT_LISTEN_PORT} \
          --metrics-export-port=${METRICS_EXPORT_PORT} \
          $RAY_DEBUGGER_ARGS \
          \
          --block
EOFINNER
  if [[ -f "$LOG_DIR/ENDED" ]]; then
    if controlled-worker-finalize-request-valid; then
      echo "[INFO] Worker \$WORKER_PROCID received authenticated final-sync request"
      exit 0
    fi
    echo "[ERROR] Worker \$WORKER_PROCID stopped without authenticated final-sync request" >&2
    exit 1
  fi
  count=\$((count+1))
  echo "[WARN] Worker \$SLURM_PROCID failed \$count/$WORKER_NUM_RETRIES times, restarting in 10 seconds..."
  sleep 10
done
touch $LOG_DIR/ENDED
exit 1
EOF
)

# Validate the generated head/worker scripts before submitting them to the cluster.
bash -n <(printf '%s' "$head_cmd") || { echo "[FATAL] Head script has syntax errors" >&2; exit 1; }
bash -n <(printf '%s' "$worker_cmd") || { echo "[FATAL] Worker script has syntax errors" >&2; exit 1; }

########################################################
# Optional sandbox sidecar for NeMo-Skills-backed Gym resources.
# Launched first so it boots in parallel with the Ray head/workers. Each per-node
# task starts the sandbox, polls its local port, and on success touches
# SANDBOX_READY_<hostname> so the head can gate the driver on all instances.
########################################################
export SLURM_MASTER_NODE=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n1)
SANDBOX_PORT="${NEMO_SKILLS_SANDBOX_PORT:-6000}"

SANDBOX_BASE_PORT="${SANDBOX_BASE_PORT:-6001}"
if [[ -n "${SANDBOX_CONTAINER:-}" ]] && [[ -n "${SANDBOX_COMMAND:-}" ]]; then
  SANDBOX_MOUNTS="$SANDBOX_PORTS_DIR:$SANDBOX_PORTS_DIR"
  if [[ -n "${SANDBOX_EXTRA_MOUNTS:-}" ]]; then
    SANDBOX_MOUNTS="${SANDBOX_EXTRA_MOUNTS},${SANDBOX_MOUNTS}"
  fi

  SANDBOX_EXPORTS="ALL,SANDBOX_PORTS_DIR=$SANDBOX_PORTS_DIR,SANDBOX_WORKER_BASE_PORT=$SANDBOX_BASE_PORT,NGINX_PORT=$SANDBOX_PORT"
  if [[ -n "${SANDBOX_ENV_VARS:-}" ]]; then
    SANDBOX_EXPORTS="${SANDBOX_EXPORTS},${SANDBOX_ENV_VARS}"
  fi

  echo "[INFO] Starting sandbox sidecars on all allocated nodes (ports_dir=$SANDBOX_PORTS_DIR, port=$SANDBOX_PORT, base_port=$SANDBOX_BASE_PORT)..."
  srun --output "$SANDBOX_PORTS_DIR/sandbox-%t.log" \
    --error "$SANDBOX_PORTS_DIR/sandbox-%t.log" \
    --container-image="$SANDBOX_CONTAINER" \
    --container-mounts="$SANDBOX_MOUNTS" \
    --no-container-mount-home \
    --mpi=pmix \
    -A "$SLURM_JOB_ACCOUNT" \
    -p "$SLURM_JOB_PARTITION" \
    --wait=60 \
    --kill-on-bad-exit=1 \
    --overlap \
    --nodes="$SLURM_JOB_NUM_NODES" \
    --ntasks-per-node=1 \
    --export="$SANDBOX_EXPORTS" \
    bash -xc '
      ('"$SANDBOX_COMMAND"') &
      SANDBOX_PID=$!
      sandbox-tree-pids() {
        local root_pid="$1"
        local child_pid child_pids child_tree pgrep_status
        command -v pgrep >/dev/null 2>&1 || return 1
        if child_pids=$(pgrep -P "$root_pid" 2>/dev/null); then
          :
        else
          pgrep_status=$?
          (( pgrep_status == 1 )) || return 1
          child_pids=""
        fi
        for child_pid in $child_pids; do
          [[ "$child_pid" =~ ^[1-9][0-9]*$ ]] || continue
          child_tree=$(sandbox-tree-pids "$child_pid") || return 1
          printf "%s\n" "$child_tree"
        done
        printf "%s\n" "$root_pid"
      }
      stop-sandbox-tree() {
        local tracked_pid tree_output alive=0 collection_failed=0
        local forced=0 reap_failed=0
        local deadline force_deadline
        local -a tracked_pids=()
        trap - USR1
        if tree_output=$(sandbox-tree-pids "$SANDBOX_PID"); then
          while IFS= read -r tracked_pid; do
            [[ "$tracked_pid" =~ ^[1-9][0-9]*$ ]] || continue
            tracked_pids+=("$tracked_pid")
          done <<< "$tree_output"
        else
          collection_failed=1
          tracked_pids+=("$SANDBOX_PID")
          echo "[ERROR] Could not enumerate sandbox process tree"
        fi
        kill -TERM "${tracked_pids[@]}" 2>/dev/null || true
        deadline=$((SECONDS + 10))
        while (( SECONDS < deadline )); do
          alive=0
          for tracked_pid in "${tracked_pids[@]}"; do
            if kill -0 "$tracked_pid" 2>/dev/null; then alive=1; break; fi
          done
          (( alive == 1 )) || break
          sleep 1
        done
        if (( alive == 1 )); then
          forced=1
          if tree_output=$(sandbox-tree-pids "$SANDBOX_PID"); then
            while IFS= read -r tracked_pid; do
              [[ "$tracked_pid" =~ ^[1-9][0-9]*$ ]] || continue
              tracked_pids+=("$tracked_pid")
            done <<< "$tree_output"
          else
            collection_failed=1
          fi
          kill -KILL "${tracked_pids[@]}" 2>/dev/null || true
          force_deadline=$((SECONDS + 10))
          while (( SECONDS < force_deadline )); do
            alive=0
            for tracked_pid in "${tracked_pids[@]}"; do
              if kill -0 "$tracked_pid" 2>/dev/null; then alive=1; break; fi
            done
            (( alive == 1 )) || break
            sleep 1
          done
        fi
        for tracked_pid in "${tracked_pids[@]}"; do
          if kill -0 "$tracked_pid" 2>/dev/null; then
            reap_failed=1
            break
          fi
        done
        if kill -0 "$SANDBOX_PID" 2>/dev/null; then
          reap_failed=1
        else
          wait "$SANDBOX_PID" 2>/dev/null || true
        fi
        if (( collection_failed == 1 || forced == 1 || reap_failed == 1 )); then
          # Keep the step alive so the submit-side srun watchdog performs its
          # fail-closed force phase rather than accepting incomplete or forced
          # node-local cleanup as a successful sandbox teardown.
          while :; do sleep 1; done
        fi
        exit 0
      }
      trap stop-sandbox-tree USR1
      deadline=$((SECONDS + 300))
      while ! (echo > /dev/tcp/localhost/'"$SANDBOX_PORT"') 2>/dev/null; do
        if ! kill -0 $SANDBOX_PID 2>/dev/null; then
          echo "[ERROR] Sandbox process died before becoming ready on $(hostname)"
          exit 1
        fi
        if (( SECONDS > deadline )); then
          echo "[ERROR] Sandbox not ready on $(hostname) after 5 min"
          exit 1
        fi
        sleep 2
      done
      touch '"$SANDBOX_PORTS_DIR"'/SANDBOX_READY_$(hostname)
      echo "[INFO] Sandbox ready on $(hostname):'"$SANDBOX_PORT"'"
      wait $SANDBOX_PID
    ' &
  SRUN_PIDS["sandbox"]=$!
  echo "[INFO] Sandbox sidecar started in background (PID: ${SRUN_PIDS["sandbox"]})"
else
  echo "[INFO] SANDBOX_CONTAINER or SANDBOX_COMMAND not defined, skipping sandbox startup"
fi

# Start the Ray head.
log_phase "launching Ray head + worker sruns"
srun $COMMON_SRUN_ARGS $HEAD_CONTAINER_INSTANCE_ARG --nodes=1 --ntasks=1 --cpus-per-task=$CPUS_PER_WORKER -w "$head_node" -o $LOG_DIR/ray-head.log bash -x -c "$head_cmd" &
SRUN_PIDS["ray-head"]=$!

# Start the Ray workers (all nodes except the head) with a single batched srun, so
# the number of srun/slurmctld RPCs stays constant regardless of node count. In
# single-node mode there are no workers: the head already registers its GPUs as Ray
# resources.
_num_workers=$((SLURM_JOB_NUM_NODES - 1))
if [[ $_num_workers -gt 0 ]]; then
  # srun -o with %t produces per-task log files; zero-pad to the worker-count
  # width so ray-worker-*.log filenames sort naturally (e.g. ray-worker-007.log).
  _task_digits=${#_num_workers}
  srun $COMMON_SRUN_ARGS $WORKER_CONTAINER_INSTANCE_ARG --exact \
    --nodes=$_num_workers \
    --ntasks=$_num_workers \
    --ntasks-per-node=1 \
    --cpus-per-task=$CPUS_PER_WORKER \
    --kill-on-bad-exit=0 \
    --exclude="$head_node" \
    -o "$LOG_DIR/ray-worker-%0${_task_digits}t.log" \
    bash -x -c "$worker_cmd" &
  SRUN_PIDS["ray-workers"]=$!
else
  echo "[INFO] Single-node mode: head node is the only compute node, no workers to launch"
fi

# Wait for the head container to report, via a shared-FS file, that the Ray head
# GCS is ready.
while check_srun_processes && ! test -f "$LOG_DIR/STARTED_RAY_HEAD"; do
  echo "[INFO][$(date)] Waiting for Ray head GCS to be ready..."
  sleep 2
done
log_phase "Ray head GCS up (STARTED_RAY_HEAD observed)"

validate-worker-finalize-request() {
  local session_name="$1"
  local expected
  expected=$(printf \
    'schema=ray-session-completion-v1\njob_id=%s\nrestart_count=%s\nsession=%s\naction=finalize-workers' \
    "$SLURM_JOB_ID" "$JOB_RESTART_COUNT" "$session_name")
  provenance-file-matches "$WORKER_FINALIZE_REQUEST" "$expected"
}

controlled-finalization-request-valid() {
  local session_name
  [[ -f "$LOG_DIR/RAY_SESSION_NAME" && ! -L "$LOG_DIR/RAY_SESSION_NAME" ]] || return 1
  session_name=$(<"$LOG_DIR/RAY_SESSION_NAME")
  [[ "$session_name" =~ ^session_[A-Za-z0-9._-]+$ ]] || return 1
  validate-worker-finalize-request "$session_name"
}

validate-head-final-receipt() {
  local session_name="$1"
  local attestation="$LOG_DIR/RAY_SESSION_ATTESTATIONS/head"
  local receipt="$RAY_SESSION_COMPLETION_DIR/head"
  local node expected_attestation expected_receipt
  [[ -f "$attestation" && ! -L "$attestation" ]] || return 1
  node=$(sed -n '2s/^node=//p' "$attestation")
  [[ "$node" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  expected_attestation=$(printf 'role=head\nnode=%s\nsession=%s' "$node" "$session_name")
  provenance-file-matches "$attestation" "$expected_attestation" || return 1
  expected_receipt=$(printf \
    'schema=ray-session-completion-v1\nrole=head\njob_id=%s\nrestart_count=%s\nnode=%s\nsession=%s\nexit_code=0\nsync=complete' \
    "$SLURM_JOB_ID" "$JOB_RESTART_COUNT" "$node" "$session_name")
  provenance-file-matches "$receipt" "$expected_receipt"
}

validate-worker-final-receipt() {
  local worker_index="$1"
  local session_name="$2"
  local attestation="$LOG_DIR/RAY_SESSION_ATTESTATIONS/worker-$worker_index"
  local receipt="$RAY_SESSION_COMPLETION_DIR/worker-$worker_index"
  local node expected_attestation expected_receipt
  [[ -f "$attestation" && ! -L "$attestation" ]] || return 1
  node=$(sed -n '3s/^node=//p' "$attestation")
  [[ "$node" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  expected_attestation=$(printf \
    'role=worker\nworker_index=%s\nnode=%s\nsession=%s' \
    "$worker_index" "$node" "$session_name")
  provenance-file-matches "$attestation" "$expected_attestation" || return 1
  expected_receipt=$(printf \
    'schema=ray-session-completion-v1\nrole=worker\nworker_index=%s\njob_id=%s\nrestart_count=%s\nnode=%s\nsession=%s\nexit_code=0\nsync=complete' \
    "$worker_index" "$SLURM_JOB_ID" "$JOB_RESTART_COUNT" "$node" "$session_name")
  provenance-file-matches "$receipt" "$expected_receipt"
}

write-job-completion-receipt() {
  local session_name="$1"
  local expected_workers="$2"
  atomic-write-provenance-file "$RAY_JOB_COMPLETION_RECEIPT" <<JOB_COMPLETION_EOF
schema=ray-session-completion-v1
role=job
job_id=$SLURM_JOB_ID
restart_count=$JOB_RESTART_COUNT
session=$session_name
expected_workers=$expected_workers
status=complete
exit_code=0
JOB_COMPLETION_EOF
}

cleanup-incomplete-runtime-publication() {
  local tmp_path
  [[ "$RAY_JOB_COMPLETION_RECEIPT" == "$LOG_DIR/RAY_JOB_COMPLETION" ]] || return 1
  [[ "$RAY_RUNTIME_ARTIFACT_MANIFEST" == "$LOG_DIR/RAY_RUNTIME_ARTIFACTS.json" ]] || return 1
  chmod u+w "$LOG_DIR" 2>/dev/null || true
  rm -f -- "$RAY_JOB_COMPLETION_RECEIPT" "$RAY_RUNTIME_ARTIFACT_MANIFEST" || return 1
  for tmp_path in "$LOG_DIR"/.RAY_RUNTIME_ARTIFACTS.json.*.tmp; do
    [[ -e "$tmp_path" || -L "$tmp_path" ]] || continue
    rm -f -- "$tmp_path" || return 1
  done
  [[ ! -e "$RAY_JOB_COMPLETION_RECEIPT" && ! -L "$RAY_JOB_COMPLETION_RECEIPT" ]] || return 1
  [[ ! -e "$RAY_RUNTIME_ARTIFACT_MANIFEST" && ! -L "$RAY_RUNTIME_ARTIFACT_MANIFEST" ]]
}

if [[ -n "$COMMAND" ]]; then
  # Non-interactive: the head container polls for workers, gates on sandbox
  # readiness, runs the driver (-> ray-driver.log), and exits with its status, which
  # we propagate.
  #
  # While waiting on the head, also watch the worker/sandbox sruns: if one dies
  # during bringup (e.g. a failed node), signal ENDED and stop promptly instead of
  # stalling until the head's 30-min worker deadline. check_srun_processes isn't used
  # here because it also watches the head, whose exit is the normal success path.
  set +e
  head_pid="${SRUN_PIDS["ray-head"]}"
  head_finalization_observed=0
  while kill -0 "$head_pid" 2>/dev/null; do
    for _name in ray-workers sandbox; do
      _pid="${SRUN_PIDS[$_name]:-}"
      if [[ -n "$_pid" ]] && ! kill -0 "$_pid" 2>/dev/null && \
         ! controlled-finalization-request-valid; then
        echo "[ERROR] Background srun '$_name' (pid=$_pid) exited before the head; failing fast." >&2
        head_finalization_observed=1
        touch "$LOG_DIR/ENDED"
        break 2
      fi
    done
    # The head publishes ENDED before quiescing Ray and entering its final copy.
    # Leave the bringup/driver loop at that boundary so the submit process can
    # bound the complete remote finalizer, including shared-filesystem cleanup.
    if [[ -f "$LOG_DIR/ENDED" ]]; then
      head_finalization_observed=1
      break
    fi
    sleep 2
  done
  wait-for-finalization \
    "$head_pid" "$head_finalization_observed" \
    "$RAY_FINAL_SYNC_WATCHDOG_SECONDS" "head finalization" \
    10 USR1 TERM
  head_exit_code=$?
  final_exit_code=$head_exit_code
  session_name=""

  # A zero head exit is not job completion. Authenticate both the head's final
  # atomic copy/receipt and the request it published before asking workers to
  # quiesce and publish their own receipts.
  if [[ "$head_exit_code" -eq 0 ]] && \
     [[ -f "$LOG_DIR/RAY_SESSION_NAME" ]] && \
     [[ ! -L "$LOG_DIR/RAY_SESSION_NAME" ]]; then
    session_name=$(<"$LOG_DIR/RAY_SESSION_NAME")
    if [[ "$session_name" =~ ^session_[A-Za-z0-9._-]+$ ]] && \
       validate-head-final-receipt "$session_name" && \
       validate-worker-finalize-request "$session_name"; then
      :
    else
      echo "[ERROR] Head completion provenance is missing or malformed" >&2
      final_exit_code=1
    fi
  else
    final_exit_code=${head_exit_code:-1}
    [[ "$final_exit_code" -ne 0 ]] || final_exit_code=1
  fi

  # ENDED without the authenticated request is an error shutdown. Workers accept
  # exit zero only when both files were published in the success order above.
  touch "$LOG_DIR/ENDED"

  worker_exit_code=0
  if [[ -n "${SRUN_PIDS["ray-workers"]:-}" ]]; then
    worker_pid="${SRUN_PIDS["ray-workers"]}"
    wait-for-finalization \
      "$worker_pid" 1 "$RAY_FINAL_SYNC_WATCHDOG_SECONDS" \
      "worker final-sync receipts" 10 USR1 TERM
    worker_exit_code=$?
    if [[ "$worker_exit_code" -ne 0 ]]; then
      echo "[ERROR] Ray worker srun exited non-zero during finalization: $worker_exit_code" >&2
      merge-finalization-exit-code "$final_exit_code" "$worker_exit_code"
      final_exit_code=$?
    fi
  fi

  if [[ "$final_exit_code" -eq 0 ]]; then
    for (( worker_index=0; worker_index<_num_workers; worker_index++ )); do
      if ! validate-worker-final-receipt "$worker_index" "$session_name"; then
        echo "[ERROR] Missing/malformed completion receipt for worker $worker_index" >&2
        final_exit_code=1
      fi
    done
  fi

  # Sandbox sidecars are not provenance-bearing. Stop their srun only after all
  # Ray worker receipts have either been validated or failed closed. Do not kill
  # the local srun client: Slurm records that otherwise-successful step as
  # CANCELLED (commonly ExitCode=0:9) and copies it to the allocation's
  # DerivedExitCode. USR1 is forwarded to every task, whose handler must finish
  # the sandbox tree and return zero; any forced or nonzero teardown fails closed.
  if [[ -n "${SRUN_PIDS["sandbox"]:-}" ]]; then
    if ! stop-background-processes \
      10 "sandbox teardown" USR1 TERM 1 "${SRUN_PIDS["sandbox"]}"; then
      echo "[ERROR] Sandbox teardown required forced cleanup" >&2
      merge-finalization-exit-code "$final_exit_code" 1
      final_exit_code=$?
    fi
  fi

  set -e
  exit "$final_exit_code"
else
  # Interactive: poll for workers from the submit host by reading the file the
  # head's ray-status-sidecar publishes, then write the attach helper and idle.
  RAY_STATUS_DEADLINE=$((SECONDS + 1800))
  while true; do
    worker_units=$(cat "$LOG_DIR/ray_worker_units" 2>/dev/null || echo -1)
    echo "[INFO][$(date '+%Y-%m-%dT%H:%M:%S%z')] Number of actors online: $worker_units/$NUM_ACTORS"
    if [[ "$worker_units" -eq "$NUM_ACTORS" ]]; then
      break
    fi
    check_srun_processes
    if (( SECONDS > RAY_STATUS_DEADLINE )); then
      echo "[ERROR] Timed out waiting for all workers to connect ($worker_units/$NUM_ACTORS after 30 min)"
      touch "$LOG_DIR/ENDED"
      exit 1
    fi
    sleep 5
  done

  echo "[INFO][$(date '+%Y-%m-%dT%H:%M:%S%z')] All workers connected!"

  log_phase "generating attach helper"
  echo "[INFO]: Ray Cluster is idled, run this on the slurm head node to get a shell to the head node:"
  cat <<EOF >$SLURM_SUBMIT_DIR/${SLURM_JOB_ID}-attach.sh
# No args launches on the head node (node 0)
# Args 1-N launch on worker nodes (nodes 1 through N-1)
# Optional: set COMMAND='...' to run non-interactively instead of opening an interactive shell
WORKER_NUM=\${1:-}
if [[ -z "\$WORKER_NUM" ]]; then
  if [[ -n "\${COMMAND:-}" ]]; then
    srun --no-container-mount-home $GRES_ARG -A $SLURM_JOB_ACCOUNT -p $SLURM_JOB_PARTITION --overlap $HEAD_CONTAINER_INSTANCE_ARG --container-workdir=$CONTAINER_CWD --nodes=1 --ntasks=1 -w "$head_node" --jobid $SLURM_JOB_ID bash -c "\$COMMAND"
  else
    srun --no-container-mount-home $GRES_ARG -A $SLURM_JOB_ACCOUNT -p $SLURM_JOB_PARTITION --overlap $HEAD_CONTAINER_INSTANCE_ARG --container-workdir=$CONTAINER_CWD --nodes=1 --ntasks=1 -w "$head_node" --jobid $SLURM_JOB_ID --pty bash
  fi
elif [[ $SLURM_JOB_NUM_NODES -eq 1 ]]; then
  echo "Error: Single-node mode — only the head node is available. Run without arguments."
  exit 1
else
  # Workers use one job/restart-scoped name per node; target a specific node.
  # Log files are 0-indexed: worker K maps to ray-worker-(K-1).log
  if [[ \$WORKER_NUM -lt 1 || \$WORKER_NUM -ge $SLURM_JOB_NUM_NODES ]]; then
    echo "Error: WORKER_NUM must be between 1 and $((SLURM_JOB_NUM_NODES-1))"
    exit 1
  fi
  nodes_array=($nodes)
  node="\${nodes_array[\$WORKER_NUM]}"
  if [[ -n "\${COMMAND:-}" ]]; then
    srun --no-container-mount-home $GRES_ARG -A $SLURM_JOB_ACCOUNT -p $SLURM_JOB_PARTITION --overlap $WORKER_CONTAINER_INSTANCE_ARG --container-workdir=$CONTAINER_CWD --nodes=1 --ntasks=1 -w "\$node" --jobid $SLURM_JOB_ID bash -c "\$COMMAND"
  else
    srun --no-container-mount-home $GRES_ARG -A $SLURM_JOB_ACCOUNT -p $SLURM_JOB_PARTITION --overlap $WORKER_CONTAINER_INSTANCE_ARG --container-workdir=$CONTAINER_CWD --nodes=1 --ntasks=1 -w "\$node" --jobid $SLURM_JOB_ID --pty bash
  fi
fi
EOF
  chmod +x $SLURM_SUBMIT_DIR/${SLURM_JOB_ID}-attach.sh
  echo "     COMMAND='echo hello' bash $SLURM_SUBMIT_DIR/${SLURM_JOB_ID}-attach.sh    # run a non-interactive command on head node"
  echo "     bash $SLURM_SUBMIT_DIR/${SLURM_JOB_ID}-attach.sh    # to attach to head node (i.e., 'worker 0')"
  if [[ $SLURM_JOB_NUM_NODES -gt 1 ]]; then
    echo "     bash $SLURM_SUBMIT_DIR/${SLURM_JOB_ID}-attach.sh 1  # to attach to worker 1"
    echo "     bash $SLURM_SUBMIT_DIR/${SLURM_JOB_ID}-attach.sh 2  # to attach to worker 2, etc."
  fi
  sleep infinity
fi
